@model IEnumerable<Ribosoft.Models.Assembly>

@{
    ViewData["Title"] = "Assembly Databases";
}

@functions {
    private string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 B";
        
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        
        return $"{size:0.##} {sizes[order]}";
    }
}

<div class="container-fluid px-3 px-md-4">
    <div class="assemblies-content">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="fas fa-database me-2 text-primary"></i>Assembly Databases
                    </h1>
                    <p class="text-muted mb-0">Manage sequence assembly databases for BLAST searches</p>
                </div>
                <div class="admin-badge-container">
                    <span class="badge bg-warning text-dark">
                        <i class="fas fa-crown me-1"></i>Admin Only
                    </span>
                </div>
            </div>
        </div>

    <!-- Alert Messages -->
    @if (TempData.ContainsKey("Alert"))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Alert"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Actions Row -->
    @if (ViewBag.RecentDownloads != null && ((List<Ribosoft.Models.DatasetDownload>)ViewBag.RecentDownloads).Any())
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-bottom">
                        <div class="d-flex align-items-center justify-content-between">
                            <h6 class="card-title mb-0">
                                <i class="fas fa-clock me-2 text-primary"></i>Recent Downloads
                            </h6>
                            <a asp-action="Downloads" class="btn btn-sm btn-outline-primary">
                                View All <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-2">
                        <div class="row g-2">
                            @foreach (var download in ((List<Ribosoft.Models.DatasetDownload>)ViewBag.RecentDownloads).Take(3))
                            {
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center p-2 border rounded">
                                        <div class="me-2">
                                            @if (download.Status == Ribosoft.Models.DatasetDownloadStatus.Completed || download.Status == Ribosoft.Models.DatasetDownloadStatus.ReadyForBlast)
                                            {
                                                <i class="fas fa-check-circle text-success"></i>
                                            }
                                            else if (download.Status == Ribosoft.Models.DatasetDownloadStatus.Downloading)
                                            {
                                                <i class="fas fa-spinner fa-spin text-primary"></i>
                                            }
                                            else if (download.Status == Ribosoft.Models.DatasetDownloadStatus.Failed)
                                            {
                                                <i class="fas fa-exclamation-triangle text-danger"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-clock text-secondary"></i>
                                            }
                                        </div>
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="fw-semibold text-truncate">@download.AccessionId</div>
                                            <small class="text-muted text-truncate d-block">@download.OrganismName</small>
                                            <small class="badge bg-light text-dark">@download.Status</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="card-title mb-1">Available Databases</h5>
                    <small class="text-muted">@Model.Count() database(s) found</small>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="BrowseDatasets" class="btn btn-success">
                        <i class="fas fa-cloud-download-alt me-1"></i>Browse NCBI Datasets
                    </a>
                    <a asp-action="Downloads" class="btn btn-info">
                        <i class="fas fa-download me-1"></i>View Downloads
                    </a>
                    <form asp-action="Rescan" method="post" class="d-inline">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-sync me-1"></i>Rescan Local
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-hashtag me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.TaxonomyId)
                                </th>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-dna me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.SpeciesId)
                                </th>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-microscope me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.OrganismName)
                                </th>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-barcode me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.AccessionId)
                                </th>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-tag me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.AssemblyName)
                                </th>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-cube me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.Type)
                                </th>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-folder me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.Path)
                                </th>
                                <th class="border-0 fw-semibold">
                                    <i class="fas fa-hdd me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.Size)
                                </th>
                                <th class="border-0 fw-semibold text-center">
                                    <i class="fas fa-toggle-on me-1 text-muted"></i>
                                    @Html.DisplayNameFor(model => model.IsEnabled)
                                </th>
                                <th class="border-0 fw-semibold text-center">
                                    <i class="fas fa-cogs me-1 text-muted"></i>
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <span class="badge bg-light text-dark border">
                                            @Html.DisplayFor(modelItem => item.TaxonomyId)
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-info text-white">
                                            @Html.DisplayFor(modelItem => item.SpeciesId)
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <div class="organism-name">
                                            <strong>@Html.DisplayFor(modelItem => item.OrganismName)</strong>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <code class="text-primary">@Html.DisplayFor(modelItem => item.AccessionId)</code>
                                    </td>
                                    <td class="align-middle">
                                        <div class="assembly-name">
                                            @Html.DisplayFor(modelItem => item.AssemblyName)
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-secondary">
                                            @Html.DisplayFor(modelItem => item.Type)
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <small class="text-muted font-monospace">
                                            @Html.DisplayFor(modelItem => item.Path)
                                        </small>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-light text-dark border">
                                            @(item.Size > 0 ? FormatFileSize(item.Size) : "Unknown")
                                        </span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input class="form-check-input assembly-toggle" 
                                                   type="checkbox" 
                                                   @(item.IsEnabled ? "checked" : "") 
                                                   data-taxonomy-id="@item.TaxonomyId"
                                                   id="toggle-@item.TaxonomyId"
                                                   title="@(item.IsEnabled ? "Click to disable" : "Click to enable")">
                                        </div>
                                    </td>
                                    <td class="align-middle text-center">
                                        <button class="btn btn-sm btn-outline-danger delete-assembly" 
                                                data-taxonomy-id="@item.TaxonomyId"
                                                data-organism-name="@item.OrganismName"
                                                data-accession-id="@item.AccessionId"
                                                data-assembly-size="@item.Size"
                                                title="Delete assembly and all files">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-database fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No Assembly Databases Found</h5>
                    <p class="text-muted mb-3">No assembly databases are currently available in the system.</p>
                    <form asp-action="Rescan" method="post" class="d-inline">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-sync me-1"></i>Scan for Databases
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Information Section -->
    <div class="info-section mt-4">
        <h6 class="mb-3">
            <i class="fas fa-info-circle me-2 text-info"></i>Assembly Database Information
        </h6>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="info-item">
                    <h6 class="small fw-semibold"><i class="fas fa-database me-2"></i>Database Purpose</h6>
                    <p class="small text-muted mb-0">Assembly databases contain genomic sequences used for BLAST searches and sequence analysis in ribozyme design workflows.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-item">
                    <h6 class="small fw-semibold"><i class="fas fa-sync me-2"></i>Rescan Function</h6>
                    <p class="small text-muted mb-2">Use the Rescan button to refresh the database list and detect newly added assembly files in the system directory.</p>
                    <p class="small text-muted mb-0"><strong>Configured Path:</strong> <code>@ViewBag.BlastDbPath</code></p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-item">
                    <h6 class="small fw-semibold"><i class="fas fa-toggle-on me-2"></i>Enable/Disable</h6>
                    <p class="small text-muted mb-0">Only enabled databases are available for use in job submissions. Disabled databases are ignored during processing.</p>
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<!-- Delete Assembly Modal -->
<div class="modal fade" id="deleteAssemblyModal" tabindex="-1" aria-labelledby="deleteAssemblyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteAssemblyModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Assembly
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-warning me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone!
                </div>
                
                <p class="mb-3">Are you sure you want to delete the assembly for:</p>
                
                <div class="card bg-light">
                    <div class="card-body">
                        <h6 class="card-title mb-2">
                            <i class="fas fa-microscope me-2 text-primary"></i>
                            <span id="modal-organism-name"></span>
                        </h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <small class="text-muted">Accession ID:</small><br>
                                <code id="modal-accession-id" class="text-primary"></code>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted">Assembly Size:</small><br>
                                <span class="badge bg-info" id="modal-assembly-size"></span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-3">
                    <h6 class="text-danger">This will:</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-times text-danger me-2"></i>Remove the assembly from the database</li>
                        <li><i class="fas fa-times text-danger me-2"></i>Delete all BLAST database files</li>
                        <li><i class="fas fa-times text-danger me-2"></i>Free up <span id="modal-size-to-free" class="fw-bold"></span> of disk space</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash-alt me-1"></i>Delete Assembly
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .assemblies-content {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        padding-bottom: 1rem;
        border-bottom: 1px solid #e9ecef;
    }

    .admin-badge-container .badge {
        font-size: 0.75rem;
        padding: 0.5rem 0.75rem;
    }

    .card {
        border-radius: 0.5rem;
    }

    .card-header {
        border-radius: 0.5rem 0.5rem 0 0 !important;
    }

    .table th {
        font-size: 0.875rem;
        padding: 1rem 0.75rem;
        vertical-align: middle;
    }

    .table td {
        padding: 0.75rem;
        vertical-align: middle;
    }

    .organism-name {
        font-size: 0.9rem;
    }

    .assembly-name {
        font-size: 0.9rem;
        font-weight: 500;
    }

    .info-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 0.375rem;
    }

    .info-item {
        padding: 1rem;
        background: white;
        border-radius: 0.375rem;
        height: 100%;
        border: 1px solid #e9ecef;
    }

    /* Mobile responsiveness */
    @@media (max-width: 768px) {
        .page-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .admin-badge-container {
            margin-top: 0.5rem;
        }

        .card-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .card-header .btn {
            margin-top: 0.5rem;
        }

        .table-responsive {
            font-size: 0.875rem;
        }

        .info-item {
            padding: 0.75rem;
        }
    }

    /* Assembly toggle styling */
    .assembly-toggle {
        cursor: pointer;
        transform: scale(1.2);
    }

    .assembly-toggle:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    /* Custom toggle colors for better visual feedback */
    .assembly-toggle:checked {
        background-color: #198754;
        border-color: #198754;
    }

    .assembly-toggle:not(:checked) {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .assembly-toggle:focus {
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }

    /* Delete button styling */
    .delete-assembly {
        transition: all 0.2s ease;
    }

    .delete-assembly:hover {
        transform: scale(1.05);
    }

    .delete-assembly:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle assembly toggle switches
        document.querySelectorAll('.assembly-toggle').forEach(function(toggle) {
            toggle.addEventListener('change', function() {
                const taxonomyId = this.dataset.taxonomyId;
                const isEnabled = this.checked;
                
                // Disable the toggle while processing
                this.disabled = true;
                this.title = 'Processing...';
                
                fetch('/Assemblies/ToggleEnabled', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: 'id=' + encodeURIComponent(taxonomyId)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Ensure the toggle reflects the actual state
                        this.checked = data.isEnabled;
                        this.title = data.isEnabled ? 'Click to disable' : 'Click to enable';
                    } else {
                        // Revert the toggle state on error
                        this.checked = !isEnabled;
                        this.title = !isEnabled ? 'Click to disable' : 'Click to enable';
                        alert('Error: ' + (data.message || 'Failed to update assembly status'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    
                    // Revert the toggle state on error
                    this.checked = !isEnabled;
                    this.title = !isEnabled ? 'Click to disable' : 'Click to enable';
                    alert('An error occurred while updating the assembly status');
                })
                .finally(() => {
                    // Re-enable the toggle
                    this.disabled = false;
                });
            });
        });

        // Handle assembly delete buttons
        document.querySelectorAll('.delete-assembly').forEach(function(button) {
            button.addEventListener('click', function() {
                const taxonomyId = this.dataset.taxonomyId;
                const organismName = this.dataset.organismName;
                const accessionId = this.dataset.accessionId || 'Unknown';
                const assemblySize = parseInt(this.dataset.assemblySize) || 0;
                const formattedSize = formatFileSize(assemblySize);
                
                // Populate modal with assembly information
                document.getElementById('modal-organism-name').textContent = organismName;
                document.getElementById('modal-accession-id').textContent = accessionId;
                document.getElementById('modal-assembly-size').textContent = formattedSize;
                document.getElementById('modal-size-to-free').textContent = formattedSize;
                
                // Store data for deletion
                const modal = document.getElementById('deleteAssemblyModal');
                modal.dataset.taxonomyId = taxonomyId;
                modal.dataset.organismName = organismName;
                
                // Show the modal
                const bootstrapModal = new bootstrap.Modal(modal);
                bootstrapModal.show();
            });
        });

        // Handle confirm delete button in modal
        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            const modal = document.getElementById('deleteAssemblyModal');
            const taxonomyId = modal.dataset.taxonomyId;
            const organismName = modal.dataset.organismName;
            
            // Disable the button while processing
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Deleting...';
            
            fetch('/Assemblies/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'id=' + encodeURIComponent(taxonomyId)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Hide the modal
                    const bootstrapModal = bootstrap.Modal.getInstance(modal);
                    bootstrapModal.hide();
                    
                    // Show success message
                    showAlert('success', data.message);
                    
                    // Remove the row from the table
                    const deleteButton = document.querySelector(`[data-taxonomy-id="${taxonomyId}"]`);
                    if (deleteButton) {
                        const row = deleteButton.closest('tr');
                        row.style.transition = 'opacity 0.3s ease';
                        row.style.opacity = '0';
                        setTimeout(() => {
                            row.remove();
                            
                            // Check if table is now empty
                            const tbody = document.querySelector('tbody');
                            if (tbody && tbody.children.length === 0) {
                                location.reload(); // Reload to show "no databases" message
                            }
                        }, 300);
                    }
                } else {
                    // Hide the modal
                    const bootstrapModal = bootstrap.Modal.getInstance(modal);
                    bootstrapModal.hide();
                    
                    // Show error message
                    showAlert('danger', data.message || 'Failed to delete assembly');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                
                // Hide the modal
                const bootstrapModal = bootstrap.Modal.getInstance(modal);
                bootstrapModal.hide();
                
                // Show error message
                showAlert('danger', 'An error occurred while deleting the assembly');
            })
            .finally(() => {
                // Re-enable the button
                this.disabled = false;
                this.innerHTML = '<i class="fas fa-trash-alt me-1"></i>Delete Assembly';
            });
        });

        // Helper function to format file sizes
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 B';
            
            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
            let order = 0;
            let size = bytes;
            
            while (size >= 1024 && order < sizes.length - 1) {
                order++;
                size /= 1024;
            }
            
            return size.toFixed(2) + ' ' + sizes[order];
        }

        // Helper function to show alert messages
        function showAlert(type, message) {
            // Remove existing alerts
            const existingAlerts = document.querySelectorAll('.alert:not(.alert-warning)');
            existingAlerts.forEach(alert => alert.remove());
            
            // Create new alert
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.setAttribute('role', 'alert');
            alertDiv.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            
            // Insert at the top of the page content
            const pageHeader = document.querySelector('.page-header');
            pageHeader.parentNode.insertBefore(alertDiv, pageHeader.nextSibling);
            
            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
    });
</script>