@using Microsoft.AspNetCore.Html
@model IEnumerable<Ribosoft.Models.DatasetDownload>

@{
    ViewData["Title"] = "Dataset Downloads";
}

<div class="container-fluid px-3 px-md-4">
    <div class="assemblies-content">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="fas fa-download me-2 text-primary"></i>Dataset Downloads
                    </h1>
                    <p class="text-muted mb-0">Monitor and manage dataset download progress and history</p>
                </div>
                <div class="admin-badge-container">
                    <span class="badge bg-warning text-dark">
                        <i class="fas fa-crown me-1"></i>Admin Only
                    </span>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav aria-label="breadcrumb" class="mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Assembly Databases</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Downloads</li>
                </ol>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Back to Assemblies
                    </a>
                    <a asp-action="BrowseDatasets" class="btn btn-success btn-sm">
                        <i class="fas fa-cloud-download-alt me-1"></i>Browse Datasets
                    </a>
                </div>
            </div>
        </nav>

        <!-- Alert Messages -->
        @if (TempData.ContainsKey("Success"))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData.ContainsKey("Error"))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Quick Actions Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light border-bottom">
                <h6 class="card-title mb-0">
                    <i class="fas fa-bolt me-2 text-primary"></i>Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-cloud-download-alt fa-2x text-success"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">Browse More Datasets</h6>
                                <p class="text-muted small mb-2">Search and download new datasets from NCBI</p>
                                <a asp-action="BrowseDatasets" class="btn btn-success btn-sm">
                                    <i class="fas fa-search me-1"></i>Browse NCBI
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-sync fa-2x text-info"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">Refresh Status</h6>
                                <p class="text-muted small mb-2">Update all download statuses manually</p>
                                <button class="btn btn-info btn-sm" onclick="refreshAllStatus()">
                                    <i class="fas fa-sync me-1"></i>Refresh All
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-clock fa-2x text-warning"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">Auto-Refresh</h6>
                                <p class="text-muted small mb-2">Toggle automatic status updates</p>
                                <button class="btn btn-outline-warning btn-sm" onclick="toggleAutoRefresh()">
                                    <i class="fas fa-clock me-1"></i>
                                    <span id="autoRefreshText">Enable Auto-Refresh</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Downloads Table Card -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title mb-1">Download History</h5>
                        <small class="text-muted">@Model.Count() download(s) total</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-0" id="downloadsTableContainer">
                @await Html.PartialAsync("_DownloadsTable", Model)
            </div>
        </div>
    </div>
</div>

<!-- Cancel Download Modal -->
<div class="modal fade" id="cancelDownloadModal" tabindex="-1" aria-labelledby="cancelDownloadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cancelDownloadModalLabel">
                    <i class="fas fa-times me-2"></i>Cancel Download
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-2">Cancel Active Download</h6>
                        <p class="mb-3">
                            Are you sure you want to cancel the download for 
                            <strong id="cancelAccessionId"></strong> 
                            (<span id="cancelOrganismName"></span>)?
                        </p>
                        
                        <div class="alert alert-warning mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <div>
                                    <strong>Warning:</strong> This action cannot be undone. Any progress made will be lost.
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle me-2"></i>
                                <div>
                                    <strong>Note:</strong> You can restart the download later using the "Browse Datasets" page.
                                </div>
                            </div>
                        </div>

                        <p class="text-muted small mb-0">
                            <i class="fas fa-clock me-1"></i>
                            The cancellation will take effect immediately and stop the background job.
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-arrow-left me-1"></i>Keep Download
                </button>
                <button type="button" class="btn btn-danger" id="confirmCancelBtn">
                    <i class="fas fa-times me-1"></i>Cancel Download
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Retry Download Modal -->
<div class="modal fade" id="retryDownloadModal" tabindex="-1" aria-labelledby="retryDownloadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="retryDownloadModalLabel">
                    <i class="fas fa-redo me-2"></i>Retry Download
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-2">Retry Failed Download</h6>
                        <p class="mb-3">
                            Are you sure you want to retry the download for 
                            <strong id="retryAccessionId"></strong> 
                            (<span id="retryOrganismName"></span>)?
                        </p>
                        
                        <div class="alert alert-info mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle me-2"></i>
                                <div>
                                    <strong>Note:</strong> This will create a new download job and attempt to download the dataset again.
                                </div>
                            </div>
                        </div>

                        <p class="text-muted small mb-0">
                            <i class="fas fa-clock me-1"></i>
                            The retry process may take several minutes depending on the dataset size.
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-warning" id="confirmRetryBtn">
                    <i class="fas fa-redo me-1"></i>Retry Download
                </button>
            </div>
        </div>
    </div>
</div>

