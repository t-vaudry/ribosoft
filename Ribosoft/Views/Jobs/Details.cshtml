@using Ribosoft.Extensions
@model Ribosoft.Models.JobsViewModels.JobDetailsViewModel

@{
    ViewData["Title"] = "Job Details";
    var shouldCancel = Model.Job.IsInProgress();
}

<div class="container-fluid px-3 px-md-4">
    <div class="job-details-content">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="fas fa-clipboard-list me-2 text-primary"></i>Job Details
                    </h1>
                    <p class="text-muted mb-0">Detailed information and results for job #@Model.Job.Id</p>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-controller="Jobs" asp-action="Index" class="text-decoration-none">Jobs</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Details</li>
                    </ol>
                </nav>
            </div>
        </div>

        <!-- Job Status and Progress Row -->
        <div class="row g-4 mb-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            <h5 class="card-title mb-0">Request Information</h5>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Id)</label>
                                    <div class="fw-bold">#@Html.DisplayFor(model => model.Job.Id)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">Status</label>
                                    <div>@await Html.PartialAsync("JobStateBadge", Model.Job.JobState)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Ribozyme)</label>
                                    <div class="fw-bold">@(Model.Job.Ribozyme?.Name ?? "Unknown")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.CreatedAt)</label>
                                    <div>@Model.Job.CreatedAt</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.StatusMessage)</label>
                                    @if (!string.IsNullOrEmpty(Model.Job.StatusMessage))
                                    {
                                        <div class="alert alert-info mb-0">
                                            <i class="fas fa-info-circle me-2"></i>@Html.DisplayFor(model => model.Job.StatusMessage)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-secondary mb-0">
                                            <i class="fas fa-info-circle me-2"></i>No status message available
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-chart-line text-success me-2"></i>Progress
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 8px;">
                            @if (Model.Job.JobState == JobState.New || Model.Job.JobState == JobState.Started)
                            {
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: 10%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.CandidateGenerator)
                            {
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.QueuedPhase2)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.Specificity)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" role="progressbar" style="width: 34%" aria-valuenow="34" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.QueuedPhase3)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 67%" aria-valuenow="67" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.MultiObjectiveOptimization)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 67%" aria-valuenow="67" aria-valuemin="0" aria-valuemax="100"></div>
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.Completed)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else
                            {
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                        </div>
                        
                        <div class="progress-steps">
                            <div class="step @(Model.Job.JobState >= JobState.CandidateGenerator ? "completed" : "")">
                                <i class="fas fa-cogs"></i>
                                <span>Generating</span>
                            </div>
                            <div class="step @(Model.Job.JobState >= JobState.Specificity ? "completed" : "")">
                                <i class="fas fa-search"></i>
                                <span>Evaluating</span>
                            </div>
                            <div class="step @(Model.Job.JobState >= JobState.MultiObjectiveOptimization ? "completed" : "")">
                                <i class="fas fa-sort-amount-down"></i>
                                <span>Ranking</span>
                            </div>
                        </div>

                        @if (shouldCancel)
                        {
                            <div class="mt-3">
                                <button type="button" class="btn btn-outline-danger w-100"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#cancelJobModal"
                                        data-job-id="@Model.Job.Id"
                                        data-job-name="@(Model.Job.Ribozyme?.Name ?? "Unknown")"
                                        data-job-created="@Model.Job.CreatedAt">
                                    <i class="fas fa-stop me-2"></i>Cancel Job
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="mt-3">
                                <button type="button" class="btn btn-outline-danger w-100"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deleteJobModal"
                                        data-job-id="@Model.Job.Id"
                                        data-job-name="@(Model.Job.Ribozyme?.Name ?? "Unknown")"
                                        data-job-created="@Model.Job.CreatedAt"
                                        data-job-state="@Model.Job.JobState">
                                    <i class="fas fa-trash me-2"></i>Delete Job
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- RNA Input Sequence Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-1">
                    <i class="fas fa-dna text-info me-2"></i>@Html.DisplayNameFor(model => model.Job.RNAInput)
                </h5>
                <small class="text-muted">Input RNA sequence for ribozyme design</small>
            </div>
            <div class="card-body">
                <div class="sequence-container">
                    <textarea class="form-control sequence-textarea" rows="6" readonly>@Model.Job.RNAInput</textarea>
                    <div class="sequence-info mt-2">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Length: @Model.Job.RNAInput.Length nucleotides
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Design Parameters Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="fas fa-sliders-h text-primary me-2"></i>Design Parameters
                        </h5>
                        <small class="text-muted">Configuration parameters used for ribozyme design</small>
                    </div>
                    <span class="badge bg-primary">
                        <i class="fas fa-dna me-1"></i>@(Model.Job.Ribozyme?.Name ?? "Unknown")
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- Target Region -->
                    <div class="col-md-6">
                        <div class="param-group">
                            <h6 class="param-group-title">
                                <i class="fas fa-crosshairs text-primary me-2"></i>Target Region
                            </h6>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.OpenReadingFrameStart)</label>
                                        <div class="param-value">@Html.DisplayFor(model => model.Job.OpenReadingFrameStart)</div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.OpenReadingFrameEnd)</label>
                                        <div class="param-value">@Html.DisplayFor(model => model.Job.OpenReadingFrameEnd)</div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.TargetTemperature)</label>
                                        <div class="param-value">@Html.DisplayFor(model => model.Job.TargetTemperature)°C</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Target Regions Selection -->
                    <div class="col-md-6">
                        <div class="param-group">
                            <h6 class="param-group-title">
                                <i class="fas fa-map-marker-alt text-info me-2"></i>Target Regions
                            </h6>
                            <div class="row g-2">
                                <div class="col-sm-4">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.FivePrime)</label>
                                        <div class="param-value">
                                            @if (Model.Job.FivePrime)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>No</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.OpenReadingFrame)</label>
                                        <div class="param-value">
                                            @if (Model.Job.OpenReadingFrame)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>No</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.ThreePrime)</label>
                                        <div class="param-value">
                                            @if (Model.Job.ThreePrime)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>No</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Environment & Chemical -->
                    <div class="col-md-6">
                        <div class="param-group">
                            <h6 class="param-group-title">
                                <i class="fas fa-flask text-secondary me-2"></i>Environment
                            </h6>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.TargetEnvironment)</label>
                                        <div class="param-value">
                                            <span class="badge bg-info">@Html.DisplayFor(model => model.Job.TargetEnvironment)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.Temperature)</label>
                                        <div class="param-value">@Html.DisplayFor(model => model.Job.Temperature)°C</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chemical Parameters -->
                    <div class="col-md-6">
                        <div class="param-group">
                            <h6 class="param-group-title">
                                <i class="fas fa-vial text-purple me-2"></i>Chemical
                            </h6>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.Na)</label>
                                        <div class="param-value">@Html.DisplayFor(model => model.Job.Na)</div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="param-item">
                                        <label class="param-label">@Html.DisplayNameFor(model => model.Job.Probe)</label>
                                        <div class="param-value">@Html.DisplayFor(model => model.Job.Probe)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Job.TargetEnvironment == TargetEnvironment.InVivo && Model.Job.AssemblyId.HasValue)
                    {
                        <!-- Assembly Information -->
                        <div class="col-12">
                            <div class="param-group">
                                <h6 class="param-group-title">
                                    <i class="fas fa-dna text-success me-2"></i>Assembly Information
                                </h6>
                                <div class="assembly-info bg-light p-3 rounded">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h6 class="mb-0">@(Model.Job.Assembly?.OrganismName ?? "Unknown")</h6>
                                        <span class="badge bg-success">@(Model.Job.Assembly?.Type ?? "Unknown")</span>
                                    </div>
                                    <div class="row g-2 small text-muted">
                                        <div class="col-md-3">
                                            <strong>Taxonomy:</strong> 
                                            @if (Model.Job.Assembly?.TaxonomyId != null)
                                            {
                                                <a href="https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=@(Model.Job.Assembly.TaxonomyId)" target="_blank" class="text-decoration-none">
                                                    @Model.Job.Assembly.TaxonomyId <i class="fas fa-external-link-alt"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span>Unknown</span>
                                            }
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Species:</strong> 
                                            @if (Model.Job.Assembly?.SpeciesId != null)
                                            {
                                                <a href="https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=@(Model.Job.Assembly.SpeciesId)" target="_blank" class="text-decoration-none">
                                                    @Model.Job.Assembly.SpeciesId <i class="fas fa-external-link-alt"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span>Unknown</span>
                                            }
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Accession:</strong> @(Model.Job.Assembly?.AccessionId ?? "Unknown")
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Method:</strong> 
                                            <span class="badge bg-primary">@Html.DisplayFor(model => model.Job.SpecificityMethod)</span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <strong>Assembly:</strong> 
                                        @if (Model.Job.Assembly?.AccessionId != null && Model.Job.Assembly?.AssemblyName != null)
                                        {
                                            <a href="https://www.ncbi.nlm.nih.gov/assembly/@(Model.Job.Assembly.AccessionId)" target="_blank" class="text-decoration-none">
                                                @Model.Job.Assembly.AssemblyName <i class="fas fa-external-link-alt"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span>Unknown</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Advanced Settings Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex align-items-center">
                    <input type="checkbox" class="form-check-input me-2" id="advancedSettingsToggle">
                    <label class="form-check-label" for="advancedSettingsToggle">
                        <h5 class="card-title mb-1">
                            <i class="fas fa-cog text-secondary me-2"></i>Advanced Settings
                        </h5>
                    </label>
                </div>
                <small class="text-muted">Click to show/hide advanced configuration parameters</small>
            </div>
            <div class="card-body advanced-settings-content" style="display: none;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.DesiredTempTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.DesiredTempTolerance)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.SpecificityTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.SpecificityTolerance)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.AccessibilityTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.AccessibilityTolerance)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.StructureTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.StructureTolerance)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Job.JobState == JobState.Completed && Model.Designs.Data.Any())
        {
            <!-- Results Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-chart-bar text-success me-2"></i>
                            <h5 class="card-title mb-0">Design Results</h5>
                        </div>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-primary btn-sm @(Context.Request.Query["minDesiredTemp"].Any() || Context.Request.Query["maxSpecificity"].Any() || Context.Request.Query["minAccessibility"].Any() || Context.Request.Query["minStructure"].Any() ? "active" : "")" onclick="refineResults()">
                                <i class="fas fa-filter me-1"></i>Filter Results
                                @if (Context.Request.Query["minDesiredTemp"].Any() || Context.Request.Query["maxSpecificity"].Any() || 
                                     Context.Request.Query["minAccessibility"].Any() || Context.Request.Query["minStructure"].Any())
                                {
                                    <span class="badge bg-white text-primary ms-1">ON</span>
                                }
                            </button>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-download me-1"></i>Export Selected
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" onclick="clickFuncAll('csv')"><i class="fas fa-file-csv me-2"></i>CSV Format</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="clickFuncAll('fasta')"><i class="fas fa-file-alt me-2"></i>FASTA Format</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="clickFuncAll('zip')"><i class="fas fa-file-archive me-2"></i>ZIP Archive</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">@Model.Designs.TotalItems ribozyme designs generated</small>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Filter Options (Initially Hidden) -->
                    <div id="filterOptions" class="border-bottom bg-light p-3" style="display: none;">
                        <form id="filterForm" class="ajax-form">
                            <input type="hidden" name="id" value="@Model.Job.Id" />
                            <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
                            <input type="hidden" name="pageNumber" value="1" />
                            
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Min Desired Temp Score</label>
                                    <input type="number" class="form-control form-control-sm" name="minDesiredTemp" 
                                           step="0.01" placeholder="e.g., 0.5" 
                                           value="@Context.Request.Query["minDesiredTemp"]">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Max Specificity Score</label>
                                    <input type="number" class="form-control form-control-sm" name="maxSpecificity" 
                                           step="0.01" placeholder="e.g., 1.0"
                                           value="@Context.Request.Query["maxSpecificity"]">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Min Accessibility Score</label>
                                    <input type="number" class="form-control form-control-sm" name="minAccessibility" 
                                           step="0.01" placeholder="e.g., 0.3"
                                           value="@Context.Request.Query["minAccessibility"]">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Min Structure Score</label>
                                    <input type="number" class="form-control form-control-sm" name="minStructure" 
                                           step="0.01" placeholder="e.g., 0.4"
                                           value="@Context.Request.Query["minStructure"]">
                                </div>
                            </div>
                            <div class="mt-3 d-flex gap-2 align-items-center">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fas fa-check me-1"></i>Apply Filters
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                                    <i class="fas fa-times me-1"></i>Clear Filters
                                </button>
                                @if (Context.Request.Query["minDesiredTemp"].Any() || Context.Request.Query["maxSpecificity"].Any() || 
                                     Context.Request.Query["minAccessibility"].Any() || Context.Request.Query["minStructure"].Any())
                                {
                                    <div class="ms-auto">
                                        <small class="text-success">
                                            <i class="fas fa-filter me-1"></i>
                                            Filters active - showing @Model.Designs.TotalItems of @Model.Designs.TotalItems results
                                        </small>
                                    </div>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- AJAX Content Container -->
                    <div id="designsContainer" class="position-relative">
                        <!-- Loading Overlay -->
                        <div id="tableLoadingOverlay" class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75 d-none" style="z-index: 10;">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <div class="mt-2 text-muted small">Updating results...</div>
                            </div>
                        </div>

                        <!-- Results Table -->
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" id="designsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="ps-3" style="width: 50px;">
                                            <input type="checkbox" class="form-check-input" id="selectAll">
                                        </th>
                                        <th scope="col" style="width: 80px;">
                                        <a href="#" class="text-decoration-none text-dark ajax-sort" data-sort="@ViewBag.RankSortParm">
                                            Rank
                                            @if (Model.SortOrder == "rank_asc")
                                            {
                                                <i class="fas fa-sort-up ms-1"></i>
                                            }
                                            else if (Model.SortOrder == "rank_desc")
                                            {
                                                <i class="fas fa-sort-down ms-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort ms-1 text-muted"></i>
                                            }
                                        </a>
                                    </th>
                                    <th scope="col" style="width: 100px;">
                                        <a href="#" class="text-decoration-none text-dark ajax-sort" data-sort="@ViewBag.CutsiteSortParm">
                                            Cutsite
                                            @if (Model.SortOrder == "cutsite_asc")
                                            {
                                                <i class="fas fa-sort-up ms-1"></i>
                                            }
                                            else if (Model.SortOrder == "cutsite_desc")
                                            {
                                                <i class="fas fa-sort-down ms-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort ms-1 text-muted"></i>
                                            }
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a href="#" class="text-decoration-none text-dark ajax-sort" data-sort="@ViewBag.DesTempSortParm">
                                            Design Temp
                                            @if (Model.SortOrder == "destemp_asc")
                                            {
                                                <i class="fas fa-sort-up ms-1"></i>
                                            }
                                            else if (Model.SortOrder == "destemp_desc")
                                            {
                                                <i class="fas fa-sort-down ms-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort ms-1 text-muted"></i>
                                            }
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a href="#" class="text-decoration-none text-dark ajax-sort" data-sort="@ViewBag.SpecSortParm">
                                            Specificity
                                            @if (Model.SortOrder == "spec_asc")
                                            {
                                                <i class="fas fa-sort-up ms-1"></i>
                                            }
                                            else if (Model.SortOrder == "spec_desc")
                                            {
                                                <i class="fas fa-sort-down ms-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort ms-1 text-muted"></i>
                                            }
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a href="#" class="text-decoration-none text-dark ajax-sort" data-sort="@ViewBag.AccessSortParm">
                                            Accessibility
                                            @if (Model.SortOrder == "access_asc")
                                            {
                                                <i class="fas fa-sort-up ms-1"></i>
                                            }
                                            else if (Model.SortOrder == "access_desc")
                                            {
                                                <i class="fas fa-sort-down ms-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort ms-1 text-muted"></i>
                                            }
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a href="#" class="text-decoration-none text-dark ajax-sort" data-sort="@ViewBag.StructSortParm">
                                            Structure
                                            @if (Model.SortOrder == "struct_asc")
                                            {
                                                <i class="fas fa-sort-up ms-1"></i>
                                            }
                                            else if (Model.SortOrder == "struct_desc")
                                            {
                                                <i class="fas fa-sort-down ms-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort ms-1 text-muted"></i>
                                            }
                                        </a>
                                    </th>
                                    <th scope="col" style="width: 140px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var design in Model.Designs.Data)
                                {
                                    <tr class="design-row" data-design-id="@design.Id">
                                        <td class="ps-3">
                                            <input type="checkbox" class="form-check-input design-checkbox" value="@design.Id">
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">@design.Rank</span>
                                        </td>
                                        <td>
                                            <code class="small">@design.CutsiteIndex</code>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@(design.DesiredTemperatureScore?.ToString("F3") ?? "N/A")</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@(design.SpecificityScore?.ToString("F3") ?? "N/A")</span>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-info" role="progressbar" 
                                                     style="width: @((design.AccessibilityScore ?? 0) * 100)%" 
                                                     aria-valuenow="@((design.AccessibilityScore ?? 0) * 100)" 
                                                     aria-valuemin="0" aria-valuemax="100">
                                                    <small class="text-white">@(design.AccessibilityScore?.ToString("F3") ?? "N/A")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-warning" role="progressbar" 
                                                     style="width: @((design.StructureScore ?? 0) * 100)%" 
                                                     aria-valuenow="@((design.StructureScore ?? 0) * 100)" 
                                                     aria-valuemin="0" aria-valuemax="100">
                                                    <small class="text-dark">@(design.StructureScore?.ToString("F3") ?? "N/A")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-primary" onclick="viewDesignDetails(@design.Id)">
                                                    <i class="fas fa-eye me-1"></i>View
                                                </button>
                                                <button type="button" class="btn btn-outline-success" onclick="downloadDesign(@design.Id, 'fasta')">
                                                    <i class="fas fa-download me-1"></i>FASTA
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Pagination -->
                    @if (Model.Designs.TotalItems > Model.Designs.PageSize)
                    {
                        var totalPages = (int)Math.Ceiling((double)Model.Designs.TotalItems / Model.Designs.PageSize);
                        <div class="card-footer bg-white border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">
                                        Showing @((Model.Designs.PageNumber - 1) * Model.Designs.PageSize + 1) to 
                                        @(Math.Min(Model.Designs.PageNumber * Model.Designs.PageSize, (int)Model.Designs.TotalItems)) 
                                        of @Model.Designs.TotalItems designs
                                    </small>
                                </div>
                                <nav aria-label="Design results pagination">
                                    <ul class="pagination pagination-sm mb-0">
                                        @if (Model.Designs.PageNumber > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link smooth-link" href="@Url.Action("Details", new { 
                                                    id = Model.Job.Id, 
                                                    sortOrder = Model.SortOrder, 
                                                    pageNumber = 1,
                                                    minDesiredTemp = Context.Request.Query["minDesiredTemp"],
                                                    maxSpecificity = Context.Request.Query["maxSpecificity"],
                                                    minAccessibility = Context.Request.Query["minAccessibility"],
                                                    minStructure = Context.Request.Query["minStructure"]
                                                })">First</a>
                                            </li>
                                            <li class="page-item">
                                                <a class="page-link ajax-page" href="#" data-page="@(Model.Designs.PageNumber - 1)">Previous</a>
                                            </li>
                                        }
                                        
                                        @{
                                            int startPage = Math.Max(1, (int)Model.Designs.PageNumber - 2);
                                            int endPage = Math.Min(totalPages, (int)Model.Designs.PageNumber + 2);
                                        }
                                        
                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == Model.Designs.PageNumber ? "active" : "")">
                                                <a class="page-link smooth-link" href="@Url.Action("Details", new { 
                                                    id = Model.Job.Id, 
                                                    sortOrder = Model.SortOrder, 
                                                    pageNumber = i,
                                                    minDesiredTemp = Context.Request.Query["minDesiredTemp"],
                                                    maxSpecificity = Context.Request.Query["maxSpecificity"],
                                                    minAccessibility = Context.Request.Query["minAccessibility"],
                                                    minStructure = Context.Request.Query["minStructure"]
                                                })">@i</a>
                                            </li>
                                        }
                                        
                                        @if (Model.Designs.PageNumber < totalPages)
                                        {
                                            <li class="page-item">
                                                <a class="page-link smooth-link" href="@Url.Action("Details", new { 
                                                    id = Model.Job.Id, 
                                                    sortOrder = Model.SortOrder, 
                                                    pageNumber = Model.Designs.PageNumber + 1,
                                                    minDesiredTemp = Context.Request.Query["minDesiredTemp"],
                                                    maxSpecificity = Context.Request.Query["maxSpecificity"],
                                                    minAccessibility = Context.Request.Query["minAccessibility"],
                                                    minStructure = Context.Request.Query["minStructure"]
                                                })">Next</a>
                                            </li>
                                            <li class="page-item">
                                                <a class="page-link smooth-link" href="@Url.Action("Details", new { 
                                                    id = Model.Job.Id, 
                                                    sortOrder = Model.SortOrder, 
                                                    pageNumber = totalPages,
                                                    minDesiredTemp = Context.Request.Query["minDesiredTemp"],
                                                    maxSpecificity = Context.Request.Query["maxSpecificity"],
                                                    minAccessibility = Context.Request.Query["minAccessibility"],
                                                    minStructure = Context.Request.Query["minStructure"]
                                                })">Last</a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    }
                    </div> <!-- End AJAX Container -->
                </div>
            </div>
        }
        else if (Model.Job.JobState == JobState.Completed)
        {
            <!-- No Results Card -->
            <div class="card mb-4">
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-exclamation-triangle text-warning mb-3" style="font-size: 3rem;"></i>
                        <h5 class="text-muted">No designs generated</h5>
                        <p class="text-muted">This job completed but did not generate any ribozyme designs. This may be due to very restrictive parameters or unsuitable input sequence.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

