</style>

        @if (Model.Job.JobState == JobState.Completed && Model.Designs.Data.Any())
        {
            <!-- Results Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">
                                <i class="fas fa-chart-bar text-success me-2"></i>Design Results
                            </h5>
                            <small class="text-muted">@Model.Designs.Data.Count() ribozyme designs generated</small>
                        </div>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="refineResults()">
                                <i class="fas fa-filter me-1"></i>Filter Results
                            </button>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-download me-1"></i>Export
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" id="csvAll"><i class="fas fa-file-csv me-2"></i>CSV Format</a></li>
                                    <li><a class="dropdown-item" href="#" id="fastaAll"><i class="fas fa-file-alt me-2"></i>FASTA Format</a></li>
                                    <li><a class="dropdown-item" href="#" id="zipAll"><i class="fas fa-file-archive me-2"></i>ZIP Archive</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Filter Options (Initially Hidden) -->
                    <div id="filterOptions" class="border-bottom p-3" style="display: none;">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <div id="structured-filter"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Results Table -->
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">
                                        <div class="d-flex align-items-center">
                                            <input type="checkbox" class="form-check-input me-2" id="selectAll">
                                            <span>Select</span>
                                        </div>
                                    </th>
                                    <th scope="col">Rank</th>
                                    <th scope="col" class="sortable" data-sort="cutsite">
                                        Cut Site
                                        <i class="fas fa-sort ms-1" id="cutsitesort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="destemp">
                                        Design Temp
                                        <i class="fas fa-sort ms-1" id="destempsort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="spec">
                                        Specificity
                                        <i class="fas fa-sort ms-1" id="specsort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="access">
                                        Accessibility
                                        <i class="fas fa-sort ms-1" id="accesssort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="struct">
                                        Structure
                                        <i class="fas fa-sort ms-1" id="structsort"></i>
                                    </th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int rank = 1;}
                                @foreach (var design in Model.Designs.Data)
                                {
                                    <tr class="design-row" data-design-id="@design.Id">
                                        <td>
                                            <input type="checkbox" class="form-check-input design-checkbox" value="@design.Id">
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">#@rank</span>
                                        </td>
                                        <td>
                                            <code class="small">@design.CutsiteIndex</code>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@design.DesiredTemperatureScore</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@design.SpecificityScore</span>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-info" role="progressbar" 
                                                     style="width: @(design.AccessibilityScore * 100)%" 
                                                     aria-valuenow="@(design.AccessibilityScore * 100)" 
                                                     aria-valuemin="0" aria-valuemax="100">
                                                    @design.AccessibilityScore
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-success" role="progressbar" 
                                                     style="width: @(design.StructureScore * 100)%" 
                                                     aria-valuenow="@(design.StructureScore * 100)" 
                                                     aria-valuemin="0" aria-valuemax="100">
                                                    @design.StructureScore
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a class="btn btn-outline-primary" asp-controller="Designs" asp-action="Details" asp-route-id="@design.Id">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-success" onclick="downloadDesign(@design.Id, 'fasta')">
                                                    <i class="fas fa-download"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (Model.Job.JobState == JobState.Completed)
        {
            <!-- No Results Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-exclamation-triangle text-warning mb-3" style="font-size: 3rem;"></i>
                        <h5 class="text-muted">No designs generated</h5>
                        <p class="text-muted">This job completed but did not generate any ribozyme designs. This may be due to very restrictive parameters or unsuitable input sequence.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Advanced settings toggle
            $('#advancedSettingsToggle').change(function() {
                const content = $('.advanced-settings-content');
                if (this.checked) {
                    content.slideDown(300);
                } else {
                    content.slideUp(300);
                }
            });

            // Select all checkbox functionality
            $('#selectAll').change(function() {
                $('.design-checkbox').prop('checked', this.checked);
            });

            // Individual checkbox change
            $('.design-checkbox').change(function() {
                const totalCheckboxes = $('.design-checkbox').length;
                const checkedCheckboxes = $('.design-checkbox:checked').length;
                $('#selectAll').prop('checked', totalCheckboxes === checkedCheckboxes);
            });

            // Sortable columns
            $('.sortable').click(function() {
                const sortType = $(this).data('sort');
                // Add sorting logic here
                console.log('Sorting by:', sortType);
            });
        });

        // Global functions for export functionality
        function refineResults() {
            const filterOptions = $('#filterOptions');
            filterOptions.toggle();
        }

        function downloadDesign(designId, format) {
            // Add download logic here
            console.log('Downloading design:', designId, 'in format:', format);
        }

        // Export functions - using original logic
        function clickFuncAll(type) {
            var form = document.createElement("form");
            form.setAttribute("method", "post");
            form.setAttribute("action", "/Designs/ExportAll");

            var hiddenField = document.createElement("input");
            hiddenField.setAttribute("type", "hidden");
            hiddenField.setAttribute("name", "jobId");
            hiddenField.setAttribute("value", @Model.Job.Id);

            var hiddenField2 = document.createElement("input");
            hiddenField2.setAttribute("type", "hidden");
            hiddenField2.setAttribute("name", "type");
            hiddenField2.setAttribute("value", type);

            form.appendChild(hiddenField);
            form.appendChild(hiddenField2);

            document.body.appendChild(form);
            form.submit();
        }

        // Export event handlers
        $('#csvAll').click(function() { return clickFuncAll("csv"); });
        $('#fastaAll').click(function() { return clickFuncAll("fasta"); });
        $('#zipAll').click(function() { return clickFuncAll("zip"); });
    </script>
    <script src="~/dist/details.js"></script>
}
