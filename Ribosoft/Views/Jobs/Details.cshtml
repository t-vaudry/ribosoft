@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // AJAX functionality for seamless table updates
            let currentFilters = {
                minDesiredTemp: '@Context.Request.Query["minDesiredTemp"]',
                maxSpecificity: '@Context.Request.Query["maxSpecificity"]',
                minAccessibility: '@Context.Request.Query["minAccessibility"]',
                minStructure: '@Context.Request.Query["minStructure"]'
            };
            let currentSortOrder = '@Model.SortOrder';
            let currentPage = @Model.Designs.PageNumber;

            // Function to update table via AJAX
            function updateTable(page = 1, sortOrder = currentSortOrder, filters = currentFilters) {
                // Show loading overlay
                $('#tableLoadingOverlay').removeClass('d-none').addClass('d-flex');
                
                // Prepare parameters
                const params = {
                    id: @Model.Job.Id,
                    pageNumber: page,
                    sortOrder: sortOrder
                };
                
                // Add filters if they have values
                if (filters.minDesiredTemp && filters.minDesiredTemp !== '') {
                    params.minDesiredTemp = filters.minDesiredTemp;
                }
                if (filters.maxSpecificity && filters.maxSpecificity !== '') {
                    params.maxSpecificity = filters.maxSpecificity;
                }
                if (filters.minAccessibility && filters.minAccessibility !== '') {
                    params.minAccessibility = filters.minAccessibility;
                }
                if (filters.minStructure && filters.minStructure !== '') {
                    params.minStructure = filters.minStructure;
                }

                // Make AJAX request
                $.get('@Url.Action("GetDesignsTable", "Jobs")', params)
                    .done(function(response) {
                        if (response.success) {
                            // Update table content
                            updateTableContent(response);
                            
                            // Update sort parameters for table headers
                            updateSortHeaders(null, response.sortOrder);
                            
                            // Update current state
                            currentPage = response.pagination.currentPage;
                            currentSortOrder = response.sortOrder;
                            
                            // Update filter form hidden fields
                            $('#filterForm input[name="sortOrder"]').val(currentSortOrder);
                            $('#filterForm input[name="pageNumber"]').val(1);
                            
                            // Re-bind only the table content event handlers (checkboxes, etc.)
                            bindTableContentEvents();
                            
                            // Update export buttons
                            updateExportButtons();
                        } else {
                            alert('Failed to update table. Please refresh the page.');
                        }
                    })
                    .fail(function(xhr, status, error) {
                        console.error('AJAX request failed:', error);
                        alert('Failed to update table. Please check your connection and try again.');
                    })
                    .always(function() {
                        // Hide loading overlay
                        $('#tableLoadingOverlay').removeClass('d-flex').addClass('d-none');
                    });
            }

            // Function to update table content with response data
            function updateTableContent(response) {
                const tbody = $('#designsTable tbody');
                tbody.empty();
                
                // Add new rows
                response.designs.forEach(function(design, index) {
                    const row = `
                        <tr>
                            <td class="ps-3">
                                <input type="checkbox" class="form-check-input design-checkbox" value="${design.id}">
                            </td>
                            <td>
                                <span class="badge bg-primary">${design.rank}</span>
                            </td>
                            <td>
                                <code class="small">${design.cutsiteIndex}</code>
                            </td>
                            <td>
                                <span class="fw-bold">${design.desiredTempScore.toFixed(3)}</span>
                            </td>
                            <td>
                                <span class="fw-bold">${design.specificityScore.toFixed(3)}</span>
                            </td>
                            <td>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar bg-info" role="progressbar" 
                                         style="width: ${(design.accessibilityScore * 100)}%" 
                                         aria-valuenow="${(design.accessibilityScore * 100)}" 
                                         aria-valuemin="0" aria-valuemax="100">
                                        <span class="fw-bold text-white">${design.accessibilityScore.toFixed(3)}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar bg-success" role="progressbar" 
                                         style="width: ${(design.structureScore * 100)}%" 
                                         aria-valuenow="${(design.structureScore * 100)}" 
                                         aria-valuemin="0" aria-valuemax="100">
                                        <span class="fw-bold text-white">${design.structureScore.toFixed(3)}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="viewDesignDetails(${design.id})">
                                        <i class="fas fa-eye me-1"></i>View
                                    </button>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                            <i class="fas fa-download me-1"></i>FASTA
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#" onclick="downloadDesign(${design.id}, 'fasta')">
                                                <i class="fas fa-file-alt me-2"></i>FASTA Format
                                            </a></li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
                
                // Update pagination info
                updatePaginationInfo(response.pagination);
            }

            // Function to update sort headers with new sort parameters
            function updateSortHeaders(sortParams, currentSort) {
                $('.ajax-sort').each(function() {
                    const $header = $(this);
                    const headerText = $header.text().trim();
                    
                    // Map header text to sort parameter base
                    let sortBase = '';
                    switch(headerText) {
                        case 'Rank': sortBase = 'rank'; break;
                        case 'Cutsite': sortBase = 'cutsite'; break;
                        case 'Design Temp': sortBase = 'destemp'; break;
                        case 'Specificity': sortBase = 'spec'; break;
                        case 'Accessibility': sortBase = 'access'; break;
                        case 'Structure': sortBase = 'struct'; break;
                    }
                    
                    // Calculate next sort direction for toggle behavior
                    let nextSort = '';
                    if (currentSort === sortBase + '_asc') {
                        nextSort = sortBase + '_desc';
                    } else if (currentSort === sortBase + '_desc') {
                        nextSort = sortBase + '_asc';
                    } else {
                        nextSort = sortBase + '_asc';
                    }
                    
                    // Update data-sort attribute for next click
                    $header.attr('data-sort', nextSort);
                    
                    // Update sort icons based on current sort state
                    const $icon = $header.find('i');
                    $icon.removeClass('fa-sort fa-sort-up fa-sort-down text-muted');
                    
                    if (currentSort === sortBase + '_asc') {
                        $icon.addClass('fa-sort-up');
                    } else if (currentSort === sortBase + '_desc') {
                        $icon.addClass('fa-sort-down');
                    } else {
                        $icon.addClass('fa-sort text-muted');
                    }
                });
            }

            // Function to update pagination info and controls
            function updatePaginationInfo(pagination) {
                // Update showing text
                const showingText = pagination.totalItems > 0 
                    ? `Showing ${pagination.showingFrom} to ${pagination.showingTo} of ${pagination.totalItems} designs`
                    : 'No designs found';
                $('.card-footer .text-muted').text(showingText);
                
                // Update pagination controls
                const paginationContainer = $('.pagination').parent();
                paginationContainer.empty();
                
                if (pagination.totalPages > 1) {
                    let paginationHtml = '<ul class="pagination pagination-sm mb-0">';
                    
                    // First and Previous buttons
                    if (pagination.hasPreviousPage) {
                        paginationHtml += `
                            <li class="page-item">
                                <a class="page-link ajax-page" href="#" data-page="1">First</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link ajax-page" href="#" data-page="${pagination.currentPage - 1}">Previous</a>
                            </li>
                        `;
                    }
                    
                    // Page numbers (show current page and a few around it)
                    const startPage = Math.max(1, pagination.currentPage - 2);
                    const endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
                    
                    for (let i = startPage; i <= endPage; i++) {
                        const activeClass = i === pagination.currentPage ? 'active' : '';
                        paginationHtml += `
                            <li class="page-item ${activeClass}">
                                <a class="page-link ajax-page" href="#" data-page="${i}">${i}</a>
                            </li>
                        `;
                    }
                    
                    // Next and Last buttons
                    if (pagination.hasNextPage) {
                        paginationHtml += `
                            <li class="page-item">
                                <a class="page-link ajax-page" href="#" data-page="${pagination.currentPage + 1}">Next</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link ajax-page" href="#" data-page="${pagination.totalPages}">Last</a>
                            </li>
                        `;
                    }
                    
                    paginationHtml += '</ul>';
                    paginationContainer.html(paginationHtml);
                }
            }

            // Function to bind table event handlers
            function bindTableEvents() {
                // Pagination click handlers
                $(document).off('click', '.ajax-page').on('click', '.ajax-page', function(e) {
                    e.preventDefault();
                    const page = parseInt($(this).data('page'));
                    updateTable(page, currentSortOrder, currentFilters);
                });
                
                // Checkbox handlers
                bindTableContentEvents();
            }
            
            // Function to bind only table content events (checkboxes, etc.)
            function bindTableContentEvents() {
                $('#selectAll').off('change').on('change', function() {
                    $('.design-checkbox').prop('checked', this.checked);
                    updateExportButtons();
                });

                $('.design-checkbox').off('change').on('change', function() {
                    const totalCheckboxes = $('.design-checkbox').length;
                    const checkedCheckboxes = $('.design-checkbox:checked').length;
                    
                    $('#selectAll').prop('indeterminate', checkedCheckboxes > 0 && checkedCheckboxes < totalCheckboxes);
                    $('#selectAll').prop('checked', checkedCheckboxes === totalCheckboxes);
                    updateExportButtons();
                });
            }

            // Filter form submission
            $('#filterForm').on('submit', function(e) {
                e.preventDefault();
                
                // Get filter values
                const filters = {
                    minDesiredTemp: $('input[name="minDesiredTemp"]').val(),
                    maxSpecificity: $('input[name="maxSpecificity"]').val(),
                    minAccessibility: $('input[name="minAccessibility"]').val(),
                    minStructure: $('input[name="minStructure"]').val()
                };
                
                currentFilters = filters;
                updateTable(1, currentSortOrder, filters);
            });

            // Clear filters function
            window.clearFilters = function() {
                // Clear form inputs
                $('#filterForm input[type="number"]').val('');
                
                // Reset filters
                currentFilters = {
                    minDesiredTemp: '',
                    maxSpecificity: '',
                    minAccessibility: '',
                    minStructure: ''
                };
                
                // Update table
                updateTable(1, currentSortOrder, currentFilters);
            };

            // Initialize event handlers
            bindTableEvents();
            
            // Initialize sort headers
            updateSortHeaders(null, '@Model.SortOrder');
            
            // Bind sort click handlers (bound once, never re-bound)
            $(document).on('click', '.ajax-sort', function(e) {
                e.preventDefault();
                const sortOrder = $(this).attr('data-sort');
                updateTable(1, sortOrder, currentFilters);
            });

            // Auto-refresh for in-progress jobs
            @if (Model.Job.IsInProgress())
            {
                <text>
                setInterval(function() {
                    location.reload();
                }, 30000); // Refresh every 30 seconds
                </text>
            }

            // Auto-show filter options if filters are active
            @if (Context.Request.Query["minDesiredTemp"].Any() || Context.Request.Query["maxSpecificity"].Any() || 
                 Context.Request.Query["minAccessibility"].Any() || Context.Request.Query["minStructure"].Any())
            {
                <text>
                $('#filterOptions').show();
                </text>
            }

            // Select all checkbox functionality
            $('#selectAll').change(function() {
                $('.design-checkbox').prop('checked', this.checked);
                updateExportButtons();
            });

            $('.design-checkbox').change(function() {
                const totalCheckboxes = $('.design-checkbox').length;
                const checkedCheckboxes = $('.design-checkbox:checked').length;
                
                $('#selectAll').prop('indeterminate', checkedCheckboxes > 0 && checkedCheckboxes < totalCheckboxes);
                $('#selectAll').prop('checked', checkedCheckboxes === totalCheckboxes);
                updateExportButtons();
            });

            // Table sorting functionality
            $('.sortable').click(function() {
                const sortType = $(this).data('sort');
                const isAscending = !$(this).hasClass('sort-asc');
                
                // Remove sort classes from all headers
                $('.sortable').removeClass('sort-asc sort-desc');
                $('.sortable i').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
                
                // Add sort class to current header
                $(this).addClass(isAscending ? 'sort-asc' : 'sort-desc');
                $(this).find('i').removeClass('fa-sort').addClass(isAscending ? 'fa-sort-up' : 'fa-sort-down');
                
                sortTable(sortType, isAscending);
            });
        });

        // Table sorting function
        function sortTable(sortType, ascending) {
            const tbody = $('#designsTable tbody');
            const rows = tbody.find('tr').toArray();
            
            rows.sort(function(a, b) {
                let aVal, bVal;
                
                switch(sortType) {
                    case 'desired-temp':
                        aVal = parseFloat($(a).find('td[data-value]').eq(0).data('value')) || 0;
                        bVal = parseFloat($(b).find('td[data-value]').eq(0).data('value')) || 0;
                        break;
                    case 'specificity':
                        aVal = parseFloat($(a).find('td[data-value]').eq(1).data('value')) || 0;
                        bVal = parseFloat($(b).find('td[data-value]').eq(1).data('value')) || 0;
                        break;
                    case 'accessibility':
                        aVal = parseFloat($(a).find('td[data-value]').eq(2).data('value')) || 0;
                        bVal = parseFloat($(b).find('td[data-value]').eq(2).data('value')) || 0;
                        break;
                    case 'structure':
                        aVal = parseFloat($(a).find('td[data-value]').eq(3).data('value')) || 0;
                        bVal = parseFloat($(b).find('td[data-value]').eq(3).data('value')) || 0;
                        break;
                    default:
                        return 0;
                }
                
                if (ascending) {
                    return aVal - bVal;
                } else {
                    return bVal - aVal;
                }
            });
            
            tbody.empty().append(rows);
        }

        // Filter functionality
        function refineResults() {
            $('#filterOptions').toggle();
        }

        function applyFilters() {
            const minDesiredTemp = parseFloat($('#minDesiredTemp').val()) || -Infinity;
            const maxSpecificity = parseFloat($('#maxSpecificity').val()) || Infinity;
            const minAccessibility = parseFloat($('#minAccessibility').val()) || -Infinity;
            const minStructure = parseFloat($('#minStructure').val()) || -Infinity;
            
            $('#designsTable tbody tr').each(function() {
                const row = $(this);
                const desiredTemp = parseFloat(row.find('td[data-value]').eq(0).data('value')) || 0;
                const specificity = parseFloat(row.find('td[data-value]').eq(1).data('value')) || 0;
                const accessibility = parseFloat(row.find('td[data-value]').eq(2).data('value')) || 0;
                const structure = parseFloat(row.find('td[data-value]').eq(3).data('value')) || 0;
                
                const visible = desiredTemp >= minDesiredTemp && 
                               specificity <= maxSpecificity && 
                               accessibility >= minAccessibility && 
                               structure >= minStructure;
                
                row.toggle(visible);
            });
        }

        function clearFilters() {
            $('#minDesiredTemp, #maxSpecificity, #minAccessibility, #minStructure').val('');
            $('#designsTable tbody tr').show();
        }

        // Design details modal
        function viewDesignDetails(designId) {
            $('#designDetailsModal').modal('show');
            $('#downloadDesignFromModal').data('design-id', designId);
            
            // Reset modal content to loading state
            $('#designDetailsContent').html(`
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading design details...</p>
                </div>
            `);
            
            // Load modal content via AJAX using the correct endpoint
            $.get(`/Designs/ModalDetails/${designId}`)
                .done(function(data) {
                    $('#designDetailsContent').html(data);
                })
                .fail(function(xhr, status, error) {
                    console.error('Failed to load design details:', xhr.responseText, status, error);
                    $('#designDetailsContent').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Failed to load design details.</strong><br>
                            ${xhr.responseJSON?.message || error || 'Please try again or contact support if the problem persists.'}
                        </div>
                    `);
                });
        }

        // Download functionality
        function downloadDesign(designId, format) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Designs/Export';
            
            const designIdField = document.createElement('input');
            designIdField.type = 'hidden';
            designIdField.name = 'designId';
            designIdField.value = designId;
            
            const formatField = document.createElement('input');
            formatField.type = 'hidden';
            formatField.name = 'format';
            formatField.value = format;
            
            form.appendChild(designIdField);
            form.appendChild(formatField);
            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
        }

        // Export all functionality
        function clickFuncAll(type) {
            const selectedDesigns = $('.design-checkbox:checked').map(function() {
                return this.value;
            }).get();
            
            if (selectedDesigns.length === 0) {
                alert('Please select at least one design to export.');
                return;
            }
            
            // Get the clicked dropdown item to show progress
            const clickedItem = event.target.closest('a');
            const originalText = clickedItem.innerHTML;
            
            // Show progress indicator on the export button
            const exportButton = document.querySelector('.btn-outline-success.dropdown-toggle');
            const originalButtonText = exportButton.innerHTML;
            exportButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Preparing Export...';
            exportButton.disabled = true;
            
            // Also update the clicked dropdown item
            clickedItem.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Preparing...';
            clickedItem.style.pointerEvents = 'none';
            
            // Prepare the data in the format the controller expects: "{jobId}-{designId}": true
            const selectedDesignsObj = {};
            const jobId = @Model.Job.Id;
            selectedDesigns.forEach(designId => {
                const key = jobId + '-' + designId;
                selectedDesignsObj[key] = true;
            });
            
            const selectedDesignsJson = JSON.stringify(selectedDesignsObj);
            console.log('Sending selectedDesigns:', selectedDesignsJson);
            
            // Make AJAX request to the correct endpoint
            $.ajax({
                url: '/Jobs/DownloadSelectedDesigns',
                type: 'POST',
                data: {
                    jobID: jobId,
                    selectedDesigns: selectedDesignsJson,
                    format: type,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    console.log('Export response:', response);
                    
                    if (response.fileGuid || response.FileGuid) {
                        // Handle both cases for compatibility
                        const fileGuid = response.fileGuid || response.FileGuid;
                        const fileName = response.fileName || response.FileName;
                        const fileType = response.fileType || response.FileType;
                        
                        // Update progress indicator
                        exportButton.innerHTML = '<i class="fas fa-download me-1"></i>Downloading...';
                        clickedItem.innerHTML = '<i class="fas fa-download me-2"></i>Downloading...';
                        
                        // Trigger download using hidden iframe (prevents page redirect)
                        const downloadUrl = '/Jobs/Download?fileGuid=' + encodeURIComponent(fileGuid) + 
                                          '&fileName=' + encodeURIComponent(fileName) + 
                                          '&fileType=' + encodeURIComponent(fileType);
                        
                        console.log('Download URL:', downloadUrl);
                        
                        // Create hidden iframe for seamless download
                        const iframe = document.createElement('iframe');
                        iframe.style.display = 'none';
                        iframe.src = downloadUrl;
                        document.body.appendChild(iframe);
                        
                        // Show success message briefly
                        setTimeout(() => {
                            exportButton.innerHTML = '<i class="fas fa-check me-1"></i>Downloaded!';
                            clickedItem.innerHTML = '<i class="fas fa-check me-2"></i>Downloaded!';
                        }, 1000);
                        
                        // Clean up and restore original state
                        setTimeout(() => {
                            if (document.body.contains(iframe)) {
                                document.body.removeChild(iframe);
                            }
                            exportButton.innerHTML = originalButtonText;
                            exportButton.disabled = false;
                            clickedItem.innerHTML = originalText;
                            clickedItem.style.pointerEvents = 'auto';
                        }, 3000);
                        
                    } else {
                        console.error('No fileGuid in response:', response);
                        exportButton.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Export Failed';
                        clickedItem.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Failed';
                        
                        setTimeout(() => {
                            exportButton.innerHTML = originalButtonText;
                            exportButton.disabled = false;
                            clickedItem.innerHTML = originalText;
                            clickedItem.style.pointerEvents = 'auto';
                        }, 3000);
                        
                        alert('Export failed: No file generated. Please try again.');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Export failed:', xhr.responseText, status, error);
                    
                    exportButton.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Export Failed';
                    clickedItem.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Failed';
                    
                    setTimeout(() => {
                        exportButton.innerHTML = originalButtonText;
                        exportButton.disabled = false;
                        clickedItem.innerHTML = originalText;
                        clickedItem.style.pointerEvents = 'auto';
                    }, 3000);
                    
                    let errorMessage = 'Export failed. Please try again.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = 'Export failed: ' + xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        try {
                            const errorData = JSON.parse(xhr.responseText);
                            if (errorData.message) {
                                errorMessage = 'Export failed: ' + errorData.message;
                            }
                        } catch (e) {
                            // Use default message if parsing fails
                        }
                    }
                    
                    alert(errorMessage);
                }
            });
        }

        function updateExportButtons() {
            const hasSelected = $('.design-checkbox:checked').length > 0;
            $('.export-btn').prop('disabled', !hasSelected);
        }

        // Modal download button
        $('#downloadDesignFromModal').click(function() {
            const designId = $(this).data('design-id');
            if (designId) {
                downloadDesign(designId, 'fasta');
            }
        });

        // Delete job modal population
        $('#deleteJobModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget); // Button that triggered the modal
            const jobId = button.data('job-id');
            const jobName = button.data('job-name');
            const jobCreated = button.data('job-created');
            const jobState = button.data('job-state');
            
            // Update modal content
            $('#delete-modal-job-id').text('#' + jobId);
            $('#delete-modal-job-name').text(jobName);
            $('#delete-modal-job-created').text(jobCreated);
            $('#delete-modal-job-state').text(jobState);
            
            // Store job ID for deletion
            $('#confirmDeleteJob').data('job-id', jobId);
        });

        // Cancel job modal population
        $('#cancelJobModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget); // Button that triggered the modal
            const jobId = button.data('job-id');
            const jobName = button.data('job-name');
            const jobCreated = button.data('job-created');
            
            // Update modal content
            $('#modal-job-id').text('#' + jobId);
            $('#modal-job-name').text(jobName);
            $('#modal-job-created').text(jobCreated);
            
            // Store job ID for cancellation
            $('#confirmCancelJob').data('job-id', jobId);
        });

        // Delete job confirmation handler
        $('#confirmDeleteJob').click(function() {
            const jobId = $(this).data('job-id');
            const button = $(this);
            const buttonText = button.find('.button-text');
            const spinner = button.find('.spinner-border');
            
            // Show loading state
            button.prop('disabled', true);
            buttonText.text('Deleting...');
            spinner.removeClass('d-none');
            
            // Make AJAX request to delete job
            $.ajax({
                url: '/Jobs/Delete/' + jobId,
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    // Hide modal and redirect to jobs list
                    $('#deleteJobModal').modal('hide');
                    window.location.href = '/Jobs';
                },
                error: function(xhr, status, error) {
                    // Reset button state
                    button.prop('disabled', false);
                    buttonText.text('Delete Job');
                    spinner.addClass('d-none');
                    
                    // Show error message
                    let errorMessage = 'Failed to delete job. Please try again.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    alert(errorMessage);
                }
            });
        });

        // Cancel job confirmation handler
        $('#confirmCancelJob').click(function() {
            const jobId = $(this).data('job-id');
            const button = $(this);
            const buttonText = button.find('.button-text');
            const spinner = button.find('.spinner-border');
            
            // Show loading state
            button.prop('disabled', true);
            buttonText.text('Cancelling...');
            spinner.removeClass('d-none');
            
            // Make AJAX request to cancel job
            $.ajax({
                url: '/Jobs/Cancel/' + jobId,
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    // Hide modal and reload page to show updated status
                    $('#cancelJobModal').modal('hide');
                    location.reload();
                },
                error: function(xhr, status, error) {
                    // Reset button state
                    button.prop('disabled', false);
                    buttonText.text('Cancel Job');
                    spinner.addClass('d-none');
                    
                    // Show error message
                    let errorMessage = 'Failed to cancel job. Please try again.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    alert(errorMessage);
                }
            });
        });
    </script>
}
