@section Scripts {
    <script>
        $(function() {
            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Cancel Job Modal Handling
            let currentJobId = null;

            // When cancel button is clicked, populate modal with job details
            $('[data-bs-target="#cancelJobModal"]').on('click', function() {
                currentJobId = $(this).data('job-id');
                const jobName = $(this).data('job-name');
                const jobCreated = $(this).data('job-created');

                $('#modal-job-id').text(currentJobId);
                $('#modal-job-name').text(jobName);
                $('#modal-job-created').text(new Date(jobCreated).toLocaleString());
            });

            // Handle the actual cancellation
            $('#confirmCancelJob').on('click', function() {
                if (!currentJobId) return;

                const $button = $(this);
                const $buttonText = $button.find('.button-text');
                const $spinner = $button.find('.spinner-border');

                // Show loading state
                $button.prop('disabled', true);
                $buttonText.text('Cancelling...');
                $spinner.removeClass('d-none');

                // Make AJAX request to cancel the job
                $.ajax({
                    url: '@Url.Action("CancelJob", "Jobs")',
                    type: 'POST',
                    data: {
                        id: currentJobId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            // Hide modal
                            $('#cancelJobModal').modal('hide');
                            
                            // Show success message and redirect to jobs index
                            showAlert('success', 'Job cancelled successfully!', 'The job has been stopped and marked as cancelled.');
                            
                            setTimeout(function() {
                                window.location.href = '@Url.Action("Index", "Jobs")';
                            }, 1500);
                        } else {
                            showAlert('danger', 'Cancellation Failed', response.message || 'An error occurred while cancelling the job.');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Cancel job error:', error);
                        showAlert('danger', 'Cancellation Failed', 'An unexpected error occurred. Please try again.');
                    },
                    complete: function() {
                        // Reset button state
                        $button.prop('disabled', false);
                        $buttonText.text('Cancel Job');
                        $spinner.addClass('d-none');
                    }
                });
            });

            // Reset modal when it's hidden
            $('#cancelJobModal').on('hidden.bs.modal', function() {
                currentJobId = null;
                $('#modal-job-id').text('-');
                $('#modal-job-name').text('-');
                $('#modal-job-created').text('-');
                
                // Reset button state
                const $button = $('#confirmCancelJob');
                $button.prop('disabled', false);
                $button.find('.button-text').text('Cancel Job');
                $button.find('.spinner-border').addClass('d-none');
            });

            // Helper function to show alerts
            function showAlert(type, title, message) {
                const iconClass = type === 'success' ? 'check-circle' : 'exclamation-triangle';
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fas fa-${iconClass} me-3 fs-4"></i>
                            <div>
                                <h5 class="alert-heading mb-1">${title}</h5>
                                <p class="mb-0">${message}</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                
                // Insert alert at the top of the job details content
                $('.job-details-content').prepend(alertHtml);
                
                // Auto-dismiss after 5 seconds
                setTimeout(function() {
                    $('.alert').first().fadeOut('slow');
                }, 5000);
            }

            // Delete Job Modal Handling
            let deleteJobId = null;

            // When delete button is clicked, populate modal with job details
            $('[data-bs-target="#deleteJobModal"]').on('click', function() {
                deleteJobId = $(this).data('job-id');
                const jobName = $(this).data('job-name');
                const jobCreated = $(this).data('job-created');
                const jobState = $(this).data('job-state');

                $('#delete-modal-job-id').text(deleteJobId);
                $('#delete-modal-job-name').text(jobName);
                $('#delete-modal-job-state').text(jobState);
                $('#delete-modal-job-created').text(new Date(jobCreated).toLocaleString());
            });

            // Handle the actual deletion
            $('#confirmDeleteJob').on('click', function() {
                if (!deleteJobId) return;

                const $button = $(this);
                const $buttonText = $button.find('.button-text');
                const $spinner = $button.find('.spinner-border');

                // Show loading state
                $button.prop('disabled', true);
                $buttonText.text('Deleting...');
                $spinner.removeClass('d-none');

                // Make AJAX request to delete the job
                $.ajax({
                    url: '@Url.Action("DeleteJob", "Jobs")',
                    type: 'POST',
                    data: {
                        id: deleteJobId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            // Hide modal
                            $('#deleteJobModal').modal('hide');
                            
                            // Show success message and redirect to jobs index
                            showAlert('success', 'Job deleted successfully!', 'The job and all its results have been permanently deleted.');
                            
                            setTimeout(function() {
                                window.location.href = '@Url.Action("Index", "Jobs")';
                            }, 1500);
                        } else {
                            showAlert('danger', 'Deletion Failed', response.message || 'An error occurred while deleting the job.');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Delete job error:', error);
                        showAlert('danger', 'Deletion Failed', 'An unexpected error occurred. Please try again.');
                    },
                    complete: function() {
                        // Reset button state
                        $button.prop('disabled', false);
                        $buttonText.text('Delete Job');
                        $spinner.addClass('d-none');
                    }
                });
            });

            // Reset delete modal when it's hidden
            $('#deleteJobModal').on('hidden.bs.modal', function() {
                deleteJobId = null;
                $('#delete-modal-job-id').text('-');
                $('#delete-modal-job-name').text('-');
                $('#delete-modal-job-state').text('-');
                $('#delete-modal-job-created').text('-');
                
                // Reset button state
                const $button = $('#confirmDeleteJob');
                $button.prop('disabled', false);
                $button.find('.button-text').text('Delete Job');
                $button.find('.spinner-border').addClass('d-none');
            });

            // Advanced settings toggle
            $('#advancedSettingsToggle').change(function() {
                const content = $('.advanced-settings-content');
                if (this.checked) {
                    content.slideDown(300);
                } else {
                    content.slideUp(300);
                }
            });

            // Select all checkbox functionality
            $('#selectAll').change(function() {
                $('.design-checkbox').prop('checked', this.checked);
            });

            // Individual checkbox change
            $('.design-checkbox').change(function() {
                const totalCheckboxes = $('.design-checkbox').length;
                const checkedCheckboxes = $('.design-checkbox:checked').length;
                $('#selectAll').prop('checked', totalCheckboxes === checkedCheckboxes);
            });

            // Sortable columns
            $('.sortable').click(function() {
                const sortType = $(this).data('sort');
                // Add sorting logic here
                console.log('Sorting by:', sortType);
            });
        });

        // Global functions for export functionality
        function refineResults() {
            const filterOptions = $('#filterOptions');
            filterOptions.toggle();
        }

        function downloadDesign(designId, format) {
            // Add download logic here
            console.log('Downloading design:', designId, 'in format:', format);
        }

        // Export functions - using original logic
        function clickFuncAll(type) {
            var form = document.createElement("form");
            form.setAttribute("method", "post");
            form.setAttribute("action", "/Designs/ExportAll");

            var hiddenField = document.createElement("input");
            hiddenField.setAttribute("type", "hidden");
            hiddenField.setAttribute("name", "jobId");
            hiddenField.setAttribute("value", @Model.Job.Id);

            var hiddenField2 = document.createElement("input");
            hiddenField2.setAttribute("type", "hidden");
            hiddenField2.setAttribute("name", "type");
            hiddenField2.setAttribute("value", type);

            form.appendChild(hiddenField);
            form.appendChild(hiddenField2);

            document.body.appendChild(form);
            form.submit();
        }

        // Export event handlers
        $('#csvAll').click(function() { return clickFuncAll("csv"); });
        $('#fastaAll').click(function() { return clickFuncAll("fasta"); });
        $('#zipAll').click(function() { return clickFuncAll("zip"); });
    </script>
