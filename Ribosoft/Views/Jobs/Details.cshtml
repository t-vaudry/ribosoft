@using Ribosoft.Extensions
@model Ribosoft.Models.JobsViewModels.JobDetailsViewModel

@{
    ViewData["Title"] = "Job Details";
    var shouldCancel = Model.Job.IsInProgress();
}

<div class="container-fluid px-3 px-md-4">
    <div class="job-details-content">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="fas fa-clipboard-list me-2 text-primary"></i>Job Details
                    </h1>
                    <p class="text-muted mb-0">Detailed information and results for job #@Model.Job.Id</p>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-controller="Jobs" asp-action="Index" class="text-decoration-none">Jobs</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Details</li>
                    </ol>
                </nav>
            </div>
        </div>

        <!-- Job Status and Progress Row -->
        <div class="row g-4 mb-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            <h5 class="card-title mb-0">Request Information</h5>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Id)</label>
                                    <div class="fw-bold">#@Html.DisplayFor(model => model.Job.Id)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">Status</label>
                                    <div>@await Html.PartialAsync("JobStateBadge", Model.Job.JobState)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Ribozyme)</label>
                                    <div class="fw-bold">@Html.DisplayFor(model => model.Job.Ribozyme.Name)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.CreatedAt)</label>
                                    <div>@Model.Job.CreatedAt</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="info-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.StatusMessage)</label>
                                    @if (!string.IsNullOrEmpty(Model.Job.StatusMessage))
                                    {
                                        <div class="alert alert-info mb-0">
                                            <i class="fas fa-info-circle me-2"></i>@Html.DisplayFor(model => model.Job.StatusMessage)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-secondary mb-0">
                                            <i class="fas fa-info-circle me-2"></i>No status message available
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-chart-line text-success me-2"></i>Progress
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 8px;">
                            @if (Model.Job.JobState == JobState.New || Model.Job.JobState == JobState.Started)
                            {
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: 10%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.CandidateGenerator)
                            {
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.QueuedPhase2)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.Specificity)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" role="progressbar" style="width: 34%" aria-valuenow="34" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.QueuedPhase3)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 67%" aria-valuenow="67" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.MultiObjectiveOptimization)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 67%" aria-valuenow="67" aria-valuemin="0" aria-valuemax="100"></div>
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else if (Model.Job.JobState == JobState.Completed)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                            else
                            {
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            }
                        </div>
                        
                        <div class="progress-steps">
                            <div class="step @(Model.Job.JobState >= JobState.CandidateGenerator ? "completed" : "")">
                                <i class="fas fa-cogs"></i>
                                <span>Generating</span>
                            </div>
                            <div class="step @(Model.Job.JobState >= JobState.Specificity ? "completed" : "")">
                                <i class="fas fa-search"></i>
                                <span>Evaluating</span>
                            </div>
                            <div class="step @(Model.Job.JobState >= JobState.MultiObjectiveOptimization ? "completed" : "")">
                                <i class="fas fa-sort-amount-down"></i>
                                <span>Ranking</span>
                            </div>
                        </div>

                        @if (shouldCancel)
                        {
                            <div class="mt-3">
                                <a class="btn btn-outline-danger w-100" asp-action="Delete" asp-route-id="@Model.Job.Id">
                                    <i class="fas fa-stop me-2"></i>Cancel Job
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- RNA Input Sequence Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-1">
                    <i class="fas fa-dna text-info me-2"></i>@Html.DisplayNameFor(model => model.Job.RNAInput)
                </h5>
                <small class="text-muted">Input RNA sequence for ribozyme design</small>
            </div>
            <div class="card-body">
                <div class="sequence-container">
                    <textarea class="form-control sequence-textarea" rows="6" readonly>@Model.Job.RNAInput</textarea>
                    <div class="sequence-info mt-2">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Length: @Model.Job.RNAInput.Length nucleotides
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Design Parameters Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-1">
                    <i class="fas fa-sliders-h text-warning me-2"></i>Design Parameters
                </h5>
                <small class="text-muted">Configuration parameters used for ribozyme design</small>
            </div>
            <div class="card-body">
                <!-- Target Region Parameters -->
                <div class="parameter-section mb-4">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-crosshairs me-2"></i>Target Region
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.OpenReadingFrameStart)</label>
                                <div class="parameter-value">@Html.DisplayFor(model => model.Job.OpenReadingFrameStart)</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.OpenReadingFrameEnd)</label>
                                <div class="parameter-value">@Html.DisplayFor(model => model.Job.OpenReadingFrameEnd)</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.TargetTemperature)</label>
                                <div class="parameter-value">@Html.DisplayFor(model => model.Job.TargetTemperature)°C</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Target Regions Selection -->
                <div class="parameter-section mb-4">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-map-marker-alt me-2"></i>Target Regions Selection
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.FivePrime)</label>
                                <div class="parameter-value">
                                    @if (Model.Job.FivePrime)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i>Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>Disabled</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.OpenReadingFrame)</label>
                                <div class="parameter-value">
                                    @if (Model.Job.OpenReadingFrame)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i>Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>Disabled</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.ThreePrime)</label>
                                <div class="parameter-value">
                                    @if (Model.Job.ThreePrime)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i>Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>Disabled</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Environment Settings -->
                <div class="parameter-section mb-4">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-flask me-2"></i>Environment Settings
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.TargetEnvironment)</label>
                                <div class="parameter-value">
                                    <span class="badge bg-info">@Html.DisplayFor(model => model.Job.TargetEnvironment)</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Temperature)</label>
                                <div class="parameter-value">@Html.DisplayFor(model => model.Job.Temperature)°C</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Job.TargetEnvironment == TargetEnvironment.InVivo && Model.Job.AssemblyId.HasValue)
                {
                    <!-- In Vivo Specific Settings -->
                    <div class="parameter-section mb-4">
                        <h6 class="text-muted mb-3">
                            <i class="fas fa-dna me-2"></i>In Vivo Assembly Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="parameter-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Assembly)</label>
                                    <div class="parameter-value">
                                        <div class="assembly-info p-3 bg-light rounded">
                                            <h6 class="mb-2">@Html.DisplayFor(model => model.Job.Assembly.OrganismName)</h6>
                                            <div class="row g-2 small text-muted">
                                                <div class="col-md-4">
                                                    <strong>Taxonomy:</strong> 
                                                    <a href="https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=@(Model.Job.Assembly.TaxonomyId)" target="_blank" class="text-decoration-none">
                                                        @Html.DisplayFor(model => model.Job.Assembly.TaxonomyId)
                                                    </a>
                                                </div>
                                                <div class="col-md-4">
                                                    <strong>Species:</strong> 
                                                    <a href="https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=@(Model.Job.Assembly.SpeciesId)" target="_blank" class="text-decoration-none">
                                                        @Html.DisplayFor(model => model.Job.Assembly.SpeciesId)
                                                    </a>
                                                </div>
                                                <div class="col-md-4">
                                                    <strong>Assembly:</strong> 
                                                    <a href="https://www.ncbi.nlm.nih.gov/assembly/@(Model.Job.Assembly.AccessionId)" target="_blank" class="text-decoration-none">
                                                        @Html.DisplayFor(model => model.Job.Assembly.AssemblyName)
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="parameter-item">
                                    <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.SpecificityMethod)</label>
                                    <div class="parameter-value">
                                        <span class="badge bg-primary">@Html.DisplayFor(model => model.Job.SpecificityMethod)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Chemical Parameters -->
                <div class="parameter-section">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-vial me-2"></i>Chemical Parameters
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Na)</label>
                                <div class="parameter-value">@Html.DisplayFor(model => model.Job.Na) M</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="parameter-item">
                                <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.Probe)</label>
                                <div class="parameter-value">@Html.DisplayFor(model => model.Job.Probe) M</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Advanced Settings Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex align-items-center">
                    <input type="checkbox" class="form-check-input me-2" id="advancedSettingsToggle">
                    <label class="form-check-label" for="advancedSettingsToggle">
                        <h5 class="card-title mb-1">
                            <i class="fas fa-cog text-secondary me-2"></i>Advanced Settings
                        </h5>
                    </label>
                </div>
                <small class="text-muted">Click to show/hide advanced configuration parameters</small>
            </div>
            <div class="card-body advanced-settings-content" style="display: none;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.DesiredTempTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.DesiredTempTolerance)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.SpecificityTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.SpecificityTolerance)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.AccessibilityTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.AccessibilityTolerance)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="parameter-item">
                            <label class="form-label text-muted small">@Html.DisplayNameFor(model => model.Job.StructureTolerance)</label>
                            <div class="parameter-value">@Html.DisplayFor(model => model.Job.StructureTolerance)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Job.JobState == JobState.Completed && Model.Designs.Data.Any())
        {
            <!-- Results Section -->
            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">
                                <i class="fas fa-chart-bar text-success me-2"></i>Design Results
                            </h5>
                            <small class="text-muted">@Model.Designs.Data.Count() ribozyme designs generated</small>
                        </div>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="refineResults()">
                                <i class="fas fa-filter me-1"></i>Filter Results
                            </button>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-download me-1"></i>Export
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" id="csvAll"><i class="fas fa-file-csv me-2"></i>CSV Format</a></li>
                                    <li><a class="dropdown-item" href="#" id="fastaAll"><i class="fas fa-file-alt me-2"></i>FASTA Format</a></li>
                                    <li><a class="dropdown-item" href="#" id="zipAll"><i class="fas fa-file-archive me-2"></i>ZIP Archive</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Filter Options (Initially Hidden) -->
                    <div id="filterOptions" class="border-bottom p-3" style="display: none;">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <div id="structured-filter"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Results Table -->
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">
                                        <div class="d-flex align-items-center">
                                            <input type="checkbox" class="form-check-input me-2" id="selectAll">
                                            <span>Select</span>
                                        </div>
                                    </th>
                                    <th scope="col">Rank</th>
                                    <th scope="col" class="sortable" data-sort="cutsite">
                                        Cut Site
                                        <i class="fas fa-sort ms-1" id="cutsitesort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="destemp">
                                        Design Temp
                                        <i class="fas fa-sort ms-1" id="destempsort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="spec">
                                        Specificity
                                        <i class="fas fa-sort ms-1" id="specsort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="access">
                                        Accessibility
                                        <i class="fas fa-sort ms-1" id="accesssort"></i>
                                    </th>
                                    <th scope="col" class="sortable" data-sort="struct">
                                        Structure
                                        <i class="fas fa-sort ms-1" id="structsort"></i>
                                    </th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int rank = 1;}
                                @foreach (var design in Model.Designs.Data)
                                {
                                    <tr class="design-row" data-design-id="@design.Id">
                                        <td>
                                            <input type="checkbox" class="form-check-input design-checkbox" value="@design.Id">
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">#@rank</span>
                                        </td>
                                        <td>
                                            <code class="small">@design.CutsiteIndex</code>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@design.DesiredTemperatureScore</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@design.SpecificityScore</span>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-info" role="progressbar" 
                                                     style="width: @(design.AccessibilityScore * 100)%" 
                                                     aria-valuenow="@(design.AccessibilityScore * 100)" 
                                                     aria-valuemin="0" aria-valuemax="100">
                                                    @design.AccessibilityScore
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-success" role="progressbar" 
                                                     style="width: @(design.StructureScore * 100)%" 
                                                     aria-valuenow="@(design.StructureScore * 100)" 
                                                     aria-valuemin="0" aria-valuemax="100">
                                                    @design.StructureScore
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a class="btn btn-outline-primary" asp-controller="Designs" asp-action="Details" asp-route-id="@design.Id">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-success" onclick="downloadDesign(@design.Id, 'fasta')">
                                                    <i class="fas fa-download"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (Model.Job.JobState == JobState.Completed)
        {
            <!-- No Results Card -->
            <div class="card mb-4">
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-exclamation-triangle text-warning mb-3" style="font-size: 3rem;"></i>
                        <h5 class="text-muted">No designs generated</h5>
                        <p class="text-muted">This job completed but did not generate any ribozyme designs. This may be due to very restrictive parameters or unsuitable input sequence.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .job-details-content {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        padding-bottom: 1rem;
        border-bottom: 1px solid #e9ecef;
    }

    .card {
        border-radius: 0.5rem;
    }

    .card-header {
        border-radius: 0.5rem 0.5rem 0 0 !important;
    }

    .info-item {
        margin-bottom: 0.5rem;
    }

    .info-item label {
        margin-bottom: 0.25rem;
        font-weight: 500;
    }

    .sequence-container {
        position: relative;
    }

    .sequence-textarea {
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        line-height: 1.4;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        resize: vertical;
    }

    .progress-steps {
        display: flex;
        justify-content: space-between;
        margin-top: 1rem;
    }

    .progress-steps .step {
        text-align: center;
        flex: 1;
        padding: 0.5rem;
        color: #6c757d;
        font-size: 0.875rem;
    }

    .progress-steps .step.completed {
        color: #198754;
    }

    .progress-steps .step i {
        display: block;
        font-size: 1.2rem;
        margin-bottom: 0.25rem;
    }

    .advanced-settings-content {
        transition: all 0.3s ease;
    }

    .sortable {
        cursor: pointer;
        user-select: none;
    }

    .sortable:hover {
        background-color: #f8f9fa;
    }

    .design-row:hover {
        background-color: #f8f9fa;
    }

    .empty-state {
        padding: 2rem;
    }

    /* Mobile responsiveness */
    @@media (max-width: 768px) {
        .page-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .page-header nav {
            margin-top: 0.5rem;
        }

        .btn-group {
            flex-direction: column;
        }

        .btn-group .btn {
            margin-bottom: 0.25rem;
        }

        .table-responsive {
            font-size: 0.875rem;
        }

        .progress-steps {
            flex-direction: column;
        }

        .progress-steps .step {
            margin-bottom: 0.5rem;
        }
