@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="fas fa-key fa-3x text-primary mb-3"></i>
                </div>
                <h1 class="h3 mb-2 font-weight-normal">Reset Your Password</h1>
                <p class="text-muted">Enter your email address and we'll send you a link to reset your password</p>
            </div>

            <!-- Success Message -->
            @if (ViewData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Success!</strong> @ViewData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="ForgotPassword" method="post" novalidate class="smooth-form" data-redirect="true">
                        <!-- Error Summary -->
                        <div asp-validation-summary="All" class="alert alert-danger validation-summary" role="alert" style="display: none;">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-exclamation-circle fa-lg text-danger"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="alert-heading mb-2">Please correct the following errors:</h6>
                                    <ul class="mb-0 small"></ul>
                                </div>
                            </div>
                        </div>

                        <!-- Email Field -->
                        <div class="form-floating mb-4">
                            <input asp-for="Email" 
                                   type="email"
                                   class="form-control" 
                                   id="email" 
                                   placeholder="name@example.com"
                                   autocomplete="email"
                                   required />
                            <label for="email">
                                <i class="fas fa-envelope me-2 text-muted"></i>Email Address
                            </label>
                            <span asp-validation-for="Email" class="invalid-feedback"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1 text-muted"></i>
                                We'll send password reset instructions to this email address
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg py-3" id="submitBtn">
                                <span class="btn-text">
                                    <i class="fas fa-paper-plane me-2"></i>
                                    Send Reset Link
                                </span>
                                <span class="btn-loading" style="display: none;">
                                    <i class="fas fa-spinner fa-spin me-2"></i>
                                    Sending...
                                </span>
                            </button>
                        </div>

                        <!-- Back to Login Link -->
                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Remember your password? 
                                <a asp-action="Login" class="text-decoration-none smooth-link">
                                    <i class="fas fa-sign-in-alt me-1"></i>Back to Sign In
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Additional Info -->
            <div class="text-center mt-4">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-center text-muted">
                            <i class="fas fa-shield-alt me-2"></i>
                            <small>Secure password reset process</small>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-center text-muted">
                            <i class="fas fa-clock me-2"></i>
                            <small>Reset link expires in 24 hours</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card border-0 bg-light mt-4">
                <div class="card-body p-3 text-center">
                    <h6 class="mb-2">
                        <i class="fas fa-question-circle me-2 text-muted"></i>
                        Need Help?
                    </h6>
                    <p class="text-muted small mb-2">
                        If you don't receive the email within a few minutes, check your spam folder or try again.
                    </p>
                    <p class="text-muted small mb-0">
                        Still having trouble? 
                        <a href="mailto:support@ribosoft.ca" class="text-decoration-none">
                            <i class="fas fa-envelope me-1"></i>Contact Support
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {    
    <style>
        /* Enhanced form validation styles */
        .form-control.is-valid {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
        }
        
        .form-control.is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15);
        }
        
        /* Subtle glow effect for focused fields */
        .form-floating > .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15), 0 0 10px rgba(13, 110, 253, 0.1);
        }
        
        /* Key icon animation */
        .fa-key {
            animation: keyFloat 3s ease-in-out infinite;
        }
        
        @@keyframes keyFloat {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-5px); }
        }
        
        /* Button hover effects */
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
            transition: all 0.2s ease;
        }
        
        /* Help section styling */
        .bg-light {
            background-color: #f8f9fa !important;
        }
    </style>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.getElementById('email');
            const form = document.querySelector('form');
            const submitBtn = document.getElementById('submitBtn');
            const validationSummary = document.querySelector('.validation-summary');
            
            // Form submission handling
            form.addEventListener('submit', function(e) {
                showLoadingState();
            });
            
            // Enhanced validation summary display - only show if there are actual errors
            function updateValidationSummary() {
                if (!validationSummary) return;
                
                // Check if ASP.NET Core has populated any validation errors
                const existingErrors = validationSummary.querySelectorAll('li');
                const hasServerErrors = existingErrors.length > 0 && 
                    Array.from(existingErrors).some(li => li.textContent.trim().length > 0);
                
                if (hasServerErrors) {
                    validationSummary.style.display = 'block';
                } else {
                    validationSummary.style.display = 'none';
                }
            }
            
            // Call validation summary update on page load
            updateValidationSummary();
            
            function showLoadingState() {
                const btnText = submitBtn.querySelector('.btn-text');
                const btnLoading = submitBtn.querySelector('.btn-loading');
                
                if (btnText && btnLoading) {
                    btnText.style.display = 'none';
                    btnLoading.style.display = 'inline';
                    submitBtn.disabled = true;
                }
            }
            
            // Email validation using HTML5 validation
            emailInput.addEventListener('blur', validateEmail);
            emailInput.addEventListener('input', function() {
                // Reset validation state when field is cleared
                if (this.value.length === 0) {
                    this.classList.remove('is-valid', 'is-invalid');
                } else if (this.classList.contains('is-invalid') || this.classList.contains('is-valid')) {
                    // Re-validate if field already has a validation state
                    validateEmail.call(this);
                }
            });
            
            function validateEmail() {
                const email = this.value;
                
                if (email.length === 0) {
                    // No validation state for empty field
                    this.classList.remove('is-valid', 'is-invalid');
                    return;
                }
                
                const isValid = this.checkValidity() && email.length > 0;
                
                if (isValid) {
                    this.classList.add('is-valid');
                    this.classList.remove('is-invalid');
                } else {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                }
            }
        });
    </script>
}
