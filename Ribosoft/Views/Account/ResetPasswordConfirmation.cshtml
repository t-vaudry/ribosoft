@{
    ViewData["Title"] = "Password Reset Complete";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="text-center mb-4">
                <h1 class="h3 mb-2 font-weight-normal">Password Reset Complete</h1>
                <p class="text-muted">Your password has been successfully updated</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 text-center">
                    <!-- Success Icon -->
                    <div class="mb-4">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-check fa-2x text-success"></i>
                        </div>
                    </div>

                    <!-- Success Message -->
                    <h5 class="fw-bold text-dark mb-3">All Set!</h5>
                    <p class="text-muted mb-4">
                        Your password has been successfully reset. You can now sign in to your Ribosoft account with your new password.
                    </p>

                    <!-- Sign In Button -->
                    <div class="d-grid mb-3">
                        <a asp-action="Login" class="btn btn-primary btn-lg py-3">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Sign In Now
                        </a>
                    </div>

                    <!-- Additional Links -->
                    <div class="text-center">
                        <p class="mb-0 text-muted small">
                            Need help? 
                            <a href="#" class="text-decoration-none">
                                <i class="fas fa-question-circle me-1"></i>Contact Support
                            </a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Security Tips -->
            <div class="mt-4">
                <div class="card border-0 bg-light">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="fas fa-lightbulb me-2 text-warning"></i>
                            Security Tips
                        </h6>
                        <ul class="small text-muted mb-0 ps-3">
                            <li>Keep your password secure and don't share it</li>
                            <li>Sign out when using shared computers</li>
                            <li>Update your password regularly</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
