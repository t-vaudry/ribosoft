@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="fas fa-envelope-open fa-3x text-success mb-3"></i>
                </div>
                <h1 class="h3 mb-2 font-weight-normal">Check Your Email</h1>
                <p class="text-muted">We've sent password reset instructions to your email address</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 text-center">
                    <div class="alert alert-success border-0" role="alert">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle fa-lg text-success"></i>
                            </div>
                            <div class="flex-grow-1 ms-3 text-start">
                                <h6 class="alert-heading mb-2">Email Sent Successfully!</h6>
                                <p class="mb-0">
                                    Please check your email inbox and follow the instructions to reset your password.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h6 class="mb-3">
                            <i class="fas fa-clock me-2 text-muted"></i>
                            What's Next?
                        </h6>
                        <div class="row g-3 text-start">
                            <div class="col-12">
                                <div class="d-flex align-items-start">
                                    <div class="flex-shrink-0 me-3">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">
                                            1
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted">Check your email inbox (and spam folder)</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex align-items-start">
                                    <div class="flex-shrink-0 me-3">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">
                                            2
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted">Click the reset link in the email</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex align-items-start">
                                    <div class="flex-shrink-0 me-3">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">
                                            3
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted">Create your new password</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-4">
                        <div class="d-grid gap-2">
                            <a asp-action="Login" class="btn btn-primary btn-lg py-3">
                                <i class="fas fa-sign-in-alt me-2"></i>
                                Back to Sign In
                            </a>
                            <a asp-action="ForgotPassword" class="btn btn-outline-secondary">
                                <i class="fas fa-redo me-2"></i>
                                Resend Email
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card border-0 bg-light mt-4">
                <div class="card-body p-3 text-center">
                    <h6 class="mb-2">
                        <i class="fas fa-question-circle me-2 text-muted"></i>
                        Didn't Receive the Email?
                    </h6>
                    <div class="row g-2 text-muted small">
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-search me-2"></i>
                                <span>Check your spam or junk folder</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-clock me-2"></i>
                                <span>Wait a few minutes and check again</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-envelope me-2"></i>
                                <span>Make sure you entered the correct email address</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">
                            Still having trouble? 
                            <a href="mailto:support@ribosoft.ca" class="text-decoration-none">
                                <i class="fas fa-life-ring me-1"></i>Contact Support
                            </a>
                        </small>
                    </div>
                </div>
            </div>

            <!-- Security Notice -->
            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="fas fa-shield-alt me-1"></i>
                    For security reasons, reset links expire in 24 hours
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    /* Envelope icon animation */
    .fa-envelope-open {
        animation: envelopeFloat 3s ease-in-out infinite;
    }
    
    @@keyframes envelopeFloat {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-5px); }
    }
    
    /* Button hover effects */
    .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
        transition: all 0.2s ease;
    }
    
    .btn-outline-secondary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transition: all 0.2s ease;
    }
    
    /* Help section styling */
    .bg-light {
        background-color: #f8f9fa !important;
    }
    
    /* Step numbers styling */
    .rounded-circle {
        font-weight: 600;
    }
</style>