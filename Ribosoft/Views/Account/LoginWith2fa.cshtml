@model LoginWith2faViewModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                </div>
                <h1 class="h3 mb-2 font-weight-normal">Two-Factor Authentication</h1>
                <p class="text-muted">Enter your authenticator code to complete sign in</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]" novalidate>
                        <input asp-for="RememberMe" type="hidden" />
                        
                        <!-- Error Summary -->
                        <div asp-validation-summary="All" class="alert alert-danger validation-summary" role="alert" style="display: none;">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-exclamation-circle fa-lg text-danger"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="alert-heading mb-2">Please correct the following errors:</h6>
                                    <ul class="mb-0 small"></ul>
                                </div>
                            </div>
                        </div>

                        <!-- Info Message -->
                        <div class="alert alert-info border-0 mb-4" role="alert">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-mobile-alt fa-lg text-info"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="alert-heading mb-2">Authenticator Required</h6>
                                    <p class="mb-0 small">Your login is protected with an authenticator app. Enter your 6-digit authenticator code below.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Two-Factor Code Field -->
                        <div class="form-floating mb-3">
                            <input asp-for="TwoFactorCode" 
                                   type="text"
                                   class="form-control text-center" 
                                   id="twoFactorCode" 
                                   placeholder="000000"
                                   autocomplete="one-time-code"
                                   inputmode="numeric"
                                   pattern="[0-9]{6}"
                                   maxlength="6"
                                   style="font-size: 1.5rem; letter-spacing: 0.5rem; font-family: 'Courier New', monospace;"
                                   required />
                            <label for="twoFactorCode">
                                <i class="fas fa-key me-2 text-muted"></i>Authenticator Code
                            </label>
                            <span asp-validation-for="TwoFactorCode" class="invalid-feedback"></span>
                        </div>

                        <!-- Remember Machine -->
                        <div class="form-check mb-4">
                            <input asp-for="RememberMachine" class="form-check-input" type="checkbox" id="rememberMachine">
                            <label class="form-check-label" for="rememberMachine">
                                <i class="fas fa-desktop me-2 text-muted"></i>Remember this device
                            </label>
                            <div class="form-text">
                                <small class="text-muted">Don't ask for codes on this device for 30 days</small>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg py-3" id="submitBtn">
                                <span class="btn-text">
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    Verify & Sign In
                                </span>
                                <span class="btn-loading" style="display: none;">
                                    <i class="fas fa-spinner fa-spin me-2"></i>
                                    Verifying...
                                </span>
                            </button>
                        </div>

                        <!-- Recovery Code Link -->
                        <div class="text-center">
                            <div class="border-top pt-3">
                                <p class="text-muted small mb-2">
                                    <i class="fas fa-question-circle me-1"></i>
                                    Don't have access to your authenticator device?
                                </p>
                                <a asp-action="LoginWithRecoveryCode" 
                                   asp-route-returnUrl="@ViewData["ReturnUrl"]" 
                                   class="text-decoration-none">
                                    <i class="fas fa-envelope me-1"></i>Send code to email instead
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Info -->
            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="fas fa-shield-alt me-1"></i>
                    Two-factor authentication keeps your account secure
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Enhanced form validation styles */
        .form-control.is-valid {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
        }
        
        .form-control.is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15);
        }
        
        /* Subtle glow effect for focused fields */
        .form-floating > .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15), 0 0 10px rgba(13, 110, 253, 0.1);
        }
        
        /* Button hover effects */
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
            transition: all 0.2s ease;
        }
        
        /* Two-factor code input styling */
        #twoFactorCode {
            font-weight: 600;
        }
        
        #twoFactorCode:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15), 0 0 15px rgba(13, 110, 253, 0.2);
        }
        
        /* Pulse animation for the shield icon */
        .fa-shield-alt {
            animation: pulse 2s infinite;
        }
        
        @@keyframes pulse {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
            100% {
                transform: scale(1);
            }
        }
    </style>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const codeInput = document.getElementById('twoFactorCode');
            const form = document.querySelector('form');
            const submitBtn = document.getElementById('submitBtn');
            const validationSummary = document.querySelector('.validation-summary');
            
            // Auto-focus the code input
            codeInput.focus();
            
            // Form submission handling
            form.addEventListener('submit', function(e) {
                showLoadingState(submitBtn);
            });
            
            // Enhanced validation summary display
            function updateValidationSummary() {
                if (!validationSummary) return;
                
                const existingErrors = validationSummary.querySelectorAll('li');
                const hasServerErrors = existingErrors.length > 0 && 
                    Array.from(existingErrors).some(li => li.textContent.trim().length > 0);
                
                if (hasServerErrors) {
                    validationSummary.style.display = 'block';
                } else {
                    validationSummary.style.display = 'none';
                }
            }
            
            // Call validation summary update on page load
            updateValidationSummary();
            
            function showLoadingState(button) {
                const btnText = button.querySelector('.btn-text');
                const btnLoading = button.querySelector('.btn-loading');
                
                if (btnText && btnLoading) {
                    btnText.style.display = 'none';
                    btnLoading.style.display = 'inline';
                    button.disabled = true;
                }
            }
            
            // Two-factor code input handling
            codeInput.addEventListener('input', function(e) {
                // Only allow numeric input
                this.value = this.value.replace(/[^0-9]/g, '');
                
                // Auto-submit when 6 digits are entered
                if (this.value.length === 6) {
                    // Add a small delay to allow user to see the complete code
                    setTimeout(() => {
                        validateCode.call(this);
                        if (this.classList.contains('is-valid')) {
                            form.submit();
                        }
                    }, 300);
                } else {
                    // Reset validation state for incomplete codes
                    this.classList.remove('is-valid', 'is-invalid');
                }
            });
            
            // Code validation
            codeInput.addEventListener('blur', validateCode);
            
            function validateCode() {
                const code = this.value;
                
                if (code.length === 0) {
                    this.classList.remove('is-valid', 'is-invalid');
                    return;
                }
                
                // Validate 6-digit numeric code
                const isValid = /^[0-9]{6}$/.test(code);
                
                if (isValid) {
                    this.classList.add('is-valid');
                    this.classList.remove('is-invalid');
                } else {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                }
            }
            
            // Handle paste events for codes
            codeInput.addEventListener('paste', function(e) {
                e.preventDefault();
                const paste = (e.clipboardData || window.clipboardData).getData('text');
                const numericPaste = paste.replace(/[^0-9]/g, '').substring(0, 6);
                this.value = numericPaste;
                
                // Trigger input event to handle validation and auto-submit
                this.dispatchEvent(new Event('input'));
            });
            
            // Keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Focus code input when user starts typing numbers
                if (/^[0-9]$/.test(e.key) && document.activeElement !== codeInput) {
                    codeInput.focus();
                }
                
                // Clear code input with Escape key
                if (e.key === 'Escape' && document.activeElement === codeInput) {
                    codeInput.value = '';
                    codeInput.classList.remove('is-valid', 'is-invalid');
                }
            });
        });
    </script>
}