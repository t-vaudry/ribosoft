@model TwoFactorAuthenticationViewModel
@{
    ViewData["Title"] = "Security Settings";
    ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<!-- Hidden CSRF token for AJAX requests -->
@Html.AntiForgeryToken()

<div class="security-content">
    <!-- Two-Factor Authentication Section -->
    <div class="form-section mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h5 class="mb-1">Two-Factor Authentication</h5>
                <p class="text-muted mb-0 small">Add an extra layer of security to your account</p>
            </div>
            <div class="status-badge">
                @if (Model.Is2faEnabled)
                {
                    <span class="badge bg-success">
                        <i class="fas fa-check me-1"></i>Enabled
                    </span>
                }
                else
                {
                    <span class="badge bg-warning">
                        <i class="fas fa-exclamation-triangle me-1"></i>Disabled
                    </span>
                }
            </div>
        </div>
            @if (Model.Is2faEnabled)
            {
                <!-- 2FA Enabled State -->
                <div class="alert alert-success border-0" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-shield-check fa-lg text-success me-3 mt-1"></i>
                        <div class="flex-grow-1">
                            <h6 class="alert-heading mb-2">Two-Factor Authentication is Active</h6>
                            <p class="mb-2">Your account is protected with two-factor authentication. You'll need your authenticator app to sign in.</p>
                            
                            <!-- Recovery Codes Status -->
                            <div class="recovery-status mt-3">
                                @if (Model.RecoveryCodesLeft == 0)
                                {
                                    <div class="alert alert-danger alert-sm mb-2">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <strong>No recovery codes left!</strong> Generate new codes immediately.
                                    </div>
                                }
                                else if (Model.RecoveryCodesLeft <= 3)
                                {
                                    <div class="alert alert-warning alert-sm mb-2">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <strong>@Model.RecoveryCodesLeft recovery codes remaining.</strong> Consider generating new codes.
                                    </div>
                                }
                                else
                                {
                                    <div class="text-success small">
                                        <i class="fas fa-check-circle me-1"></i>
                                        @Model.RecoveryCodesLeft recovery codes available
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2FA Management Actions -->
                <div class="action-buttons mt-3">
                    <button type="button" class="btn btn-outline-primary me-2" onclick="showRecoveryCodes()">
                        <i class="fas fa-cog me-1"></i>Manage Recovery Codes
                    </button>
                    <button type="button" class="btn btn-outline-warning me-2" onclick="generateRecoveryCodes()">
                        <i class="fas fa-sync me-1"></i>Generate New Codes
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="disable2FA()">
                        <i class="fas fa-shield-alt me-1"></i>Disable 2FA
                    </button>
                </div>
            }
            else
            {
                <!-- 2FA Disabled State -->
                <div class="alert alert-warning border-0" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-exclamation-triangle fa-lg text-warning me-3 mt-1"></i>
                        <div class="flex-grow-1">
                            <h6 class="alert-heading mb-2">Two-Factor Authentication is Disabled</h6>
                            <p class="mb-2">Your account is only protected by your password. Enable 2FA for better security.</p>
                            <button type="button" class="btn btn-success" onclick="enable2FA()">
                                <i class="fas fa-shield-alt me-1"></i>Enable Two-Factor Authentication
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Divider -->
    <hr class="my-4">

    <!-- Authenticator App Section -->
    <div class="form-section mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h5 class="mb-1">Authenticator App</h5>
                <p class="text-muted mb-0 small">Manage your authenticator app configuration</p>
            </div>
            <div class="status-badge">
                @if (Model.HasAuthenticator)
                {
                    <span class="badge bg-success">
                        <i class="fas fa-check me-1"></i>Configured
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        <i class="fas fa-times me-1"></i>Not Set Up
                    </span>
                }
            </div>
        </div>

        @if (Model.HasAuthenticator)
        {
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <p class="mb-1">Your authenticator app is configured and ready to use.</p>
                    <small class="text-muted">Use your authenticator app to generate verification codes.</small>
                </div>
                <div class="action-buttons">
                    <button type="button" class="btn btn-outline-primary me-2" onclick="reconfigureAuthenticator()">
                        <i class="fas fa-cog me-1"></i>Reconfigure
                    </button>
                    <button type="button" class="btn btn-outline-warning" onclick="resetAuthenticator()">
                        <i class="fas fa-sync me-1"></i>Reset Key
                    </button>
                </div>
            </div>
            }
            else
            {
                <div class="text-center py-3">
                    <i class="fas fa-mobile-alt fa-3x text-muted mb-3"></i>
                    <p class="text-muted mb-3">No authenticator app configured yet.</p>
                    <button type="button" class="btn btn-primary" onclick="setupAuthenticator()">
                        <i class="fas fa-plus me-1"></i>Set Up Authenticator App
                    </button>
                </div>
            }
    </div>

    <!-- Security Information Section -->
    <div class="security-info-section mt-5 pt-4 border-top">
        <h6 class="mb-3">
            <i class="fas fa-info-circle me-2 text-info"></i>Security Information
        </h6>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="info-item">
                    <h6 class="small fw-semibold"><i class="fas fa-shield-alt me-2"></i>Two-Factor Authentication</h6>
                    <p class="small text-muted mb-0">Adds an extra layer of security by requiring both your password and a code from your authenticator app. Highly recommended for all users.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-item">
                    <h6 class="small fw-semibold"><i class="fas fa-key me-2"></i>Recovery Codes</h6>
                    <p class="small text-muted mb-0">Use these backup codes when you don't have access to your authenticator app. Store them safely - each code can only be used once.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-item">
                    <h6 class="small fw-semibold"><i class="fas fa-mobile-alt me-2"></i>Authenticator Apps</h6>
                    <p class="small text-muted mb-0">Use apps like Microsoft Authenticator or Google Authenticator to generate secure codes. They work even when you're offline.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->

<!-- Enable 2FA Modal -->
<div class="modal fade" id="enable2FAModal" tabindex="-1" aria-labelledby="enable2FAModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="enable2FAModalLabel">
                    <i class="fas fa-shield-alt me-2"></i>Enable Two-Factor Authentication
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="authenticatorSetup">
                    <div class="setup-steps">
                        <div class="step mb-4">
                            <div class="step-header d-flex align-items-center mb-2">
                                <span class="step-number">1</span>
                                <h6 class="mb-0 ms-2">Download an Authenticator App</h6>
                            </div>
                            <p class="text-muted small ms-4">Choose one of these popular authenticator apps:</p>
                            <div class="app-links ms-4">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <div class="app-option">
                                            <strong>Microsoft Authenticator</strong><br>
                                            <small>
                                                <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank">Android</a> | 
                                                <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank">iOS</a>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="app-option">
                                            <strong>Google Authenticator</strong><br>
                                            <small>
                                                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" target="_blank">Android</a> | 
                                                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605" target="_blank">iOS</a>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="step mb-4">
                            <div class="step-header d-flex align-items-center mb-2">
                                <span class="step-number">2</span>
                                <h6 class="mb-0 ms-2">Scan QR Code or Enter Key</h6>
                            </div>
                            <div class="ms-4">
                                <div class="row">
                                    <div class="col-md-6 text-center">
                                        <p class="small text-muted mb-2">Scan this QR code:</p>
                                        <canvas id="qrCode" class="border rounded"></canvas>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-2">Or enter this key manually:</p>
                                        <div class="manual-key">
                                            <code id="manualKey" class="user-select-all"></code>
                                            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="copyKey()">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                        </div>
                                        <small class="text-muted">Spaces and casing don't matter</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="step mb-4">
                            <div class="step-header d-flex align-items-center mb-2">
                                <span class="step-number">3</span>
                                <h6 class="mb-0 ms-2">Enter Verification Code</h6>
                            </div>
                            <div class="ms-4">
                                <p class="text-muted small mb-2">Enter the 6-digit code from your authenticator app:</p>
                                <form id="verify2FAForm">
                                    <div class="input-group" style="max-width: 200px;">
                                        <input type="text" class="form-control text-center" id="verificationCode" 
                                               placeholder="000000" maxlength="6" pattern="[0-9]{6}" required>
                                        <button type="submit" class="btn btn-success">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recovery Codes Modal -->
<div class="modal fade" id="recoveryCodesModal" tabindex="-1" aria-labelledby="recoveryCodesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="recoveryCodesModalLabel">
                    <i class="fas fa-key me-2"></i>Recovery Codes
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Save these codes in a safe place!</strong><br>
                    <small>If you lose your device and don't have these codes, you'll lose access to your account.</small>
                </div>
                <div id="recoveryCodesList" class="recovery-codes-display">
                    <!-- Recovery codes will be loaded here -->
                </div>
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-outline-primary" onclick="downloadRecoveryCodes()">
                        <i class="fas fa-download me-1"></i>Download as Text
                    </button>
                    <button type="button" class="btn btn-outline-secondary ms-2" onclick="printRecoveryCodes()">
                        <i class="fas fa-print me-1"></i>Print
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modals -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmationModalBody">
                <!-- Dynamic content -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmActionBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<style>
    .security-content {
        max-width: 100%;
    }

    .form-section {
        margin-bottom: 2rem;
    }

    .status-badge .badge {
        font-size: 0.75rem;
        padding: 0.5rem 0.75rem;
    }

    .alert-sm {
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
    }

    .action-buttons .btn {
        font-size: 0.875rem;
    }

    /* Modal Styling */
    .step {
        position: relative;
    }

    .step-number {
        width: 24px;
        height: 24px;
        background: #0d6efd;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .app-option {
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 0.375rem;
        border: 1px solid #e9ecef;
    }

    .manual-key {
        background: #f8f9fa;
        padding: 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid #e9ecef;
        display: flex;
        align-items: center;
    }

    .manual-key code {
        background: none;
        color: #0d6efd;
        font-weight: 600;
        flex-grow: 1;
    }

    .recovery-codes-display {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 0.375rem;
        border: 1px solid #e9ecef;
        font-family: 'Courier New', monospace;
    }

    .recovery-code {
        display: inline-block;
        background: white;
        padding: 0.25rem 0.5rem;
        margin: 0.25rem;
        border-radius: 0.25rem;
        border: 1px solid #dee2e6;
        font-weight: 600;
    }

    /* Security Information Section */
    .security-info-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 0.375rem;
    }

    .info-item {
        padding: 1rem;
        background: white;
        border-radius: 0.375rem;
        height: 100%;
        border: 1px solid #e9ecef;
    }

    /* Mobile responsiveness */
    @@media (max-width: 576px) {
        .info-item {
            padding: 0.75rem;
        }
    }

    /* Mobile responsiveness */
    @@media (max-width: 768px) {
        .section-header {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

        .status-badge {
            align-self: flex-end;
        }

        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .action-buttons .btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <!-- QR Code Library -->
    <script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script>
    
    <script>
        (function() {
            'use strict';
            
            // Global variables for 2FA setup
            let currentSharedKey = '';
            let currentAuthenticatorUri = '';
            
            // Get CSRF token
            function getCSRFToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || 
                       document.querySelector('meta[name="__RequestVerificationToken"]')?.content || '';
            }

            // Enable 2FA - Load real data from server
            window.enable2FA = function() {
                // Show modal with loading state
                const modal = new bootstrap.Modal(document.getElementById('enable2FAModal'));
                modal.show();
                
                // Show loading in QR code area
                const qrCanvas = document.getElementById('qrCode');
                const ctx = qrCanvas.getContext('2d');
                ctx.fillStyle = '#f8f9fa';
                ctx.fillRect(0, 0, 150, 150);
                ctx.fillStyle = '#6c757d';
                ctx.font = '14px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('Loading...', 75, 75);
                
                // Load authenticator setup data from server
                fetch('/Manage/EnableAuthenticator', {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.text())
                .then(html => {
                    // Parse the HTML response to extract shared key and URI
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // Extract shared key from the server response
                    const sharedKeyElement = doc.querySelector('kbd');
                    if (sharedKeyElement) {
                        currentSharedKey = sharedKeyElement.textContent.trim();
                    }
                    
                    // Extract authenticator URI from script or data attribute
                    const scriptContent = html;
                    const uriMatch = scriptContent.match(/value:\s*["']([^"']+)["']/);
                    if (uriMatch) {
                        currentAuthenticatorUri = uriMatch[1];
                    }
                    
                    // Fallback if we can't extract from HTML
                    if (!currentSharedKey || !currentAuthenticatorUri) {
                        // Make a direct API call to get the data
                        return fetch('/Manage/GetAuthenticatorData', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': getCSRFToken()
                            }
                        }).then(response => response.json());
                    }
                    
                    return { sharedKey: currentSharedKey, authenticatorUri: currentAuthenticatorUri };
                })
                .then(data => {
                    if (data.sharedKey) {
                        currentSharedKey = data.sharedKey;
                        currentAuthenticatorUri = data.authenticatorUri;
                    }
                    
                    // Update modal content
                    document.getElementById('manualKey').textContent = currentSharedKey;
                    
                    // Generate QR code
                    if (typeof QRious !== 'undefined' && currentAuthenticatorUri) {
                        const qr = new QRious({
                            element: document.getElementById('qrCode'),
                            value: currentAuthenticatorUri,
                            size: 150
                        });
                    } else {
                        // Fallback if QRious is not available
                        const qrCanvas = document.getElementById('qrCode');
                        const ctx = qrCanvas.getContext('2d');
                        ctx.fillStyle = '#f8f9fa';
                        ctx.fillRect(0, 0, 150, 150);
                        ctx.fillStyle = '#dc3545';
                        ctx.font = '12px Arial';
                        ctx.textAlign = 'center';
                        ctx.fillText('QR Code', 75, 70);
                        ctx.fillText('Unavailable', 75, 85);
                    }
                })
                .catch(error => {
                    console.error('Error loading 2FA setup:', error);
                    modal.hide();
                    showAlert('Error loading 2FA setup. Please try again.', 'danger');
                });
            };

            // Copy key to clipboard
            window.copyKey = function() {
                if (!currentSharedKey) {
                    showAlert('No key available to copy', 'warning');
                    return;
                }
                
                navigator.clipboard.writeText(currentSharedKey).then(function() {
                    const btn = event.target.closest('button');
                    const originalIcon = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check"></i>';
                    btn.classList.add('btn-success');
                    btn.classList.remove('btn-outline-secondary');
                    
                    setTimeout(() => {
                        btn.innerHTML = originalIcon;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-secondary');
                    }, 2000);
                }).catch(err => {
                    // Fallback for older browsers
                    const textArea = document.createElement('textarea');
                    textArea.value = currentSharedKey;
                    document.body.appendChild(textArea);
                    textArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textArea);
                    showAlert('Key copied to clipboard', 'success');
                });
            };

            // Verify 2FA setup
            document.addEventListener('DOMContentLoaded', function() {
                const verifyForm = document.getElementById('verify2FAForm');
                if (verifyForm) {
                    verifyForm.addEventListener('submit', function(e) {
                        e.preventDefault();
                        const code = document.getElementById('verificationCode').value.trim();
                        
                        if (!/^\d{6}$/.test(code)) {
                            showAlert('Please enter a 6-digit code', 'warning');
                            return;
                        }
                        
                        // Show loading state
                        const submitBtn = this.querySelector('button[type="submit"]');
                        const originalContent = submitBtn.innerHTML;
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                        submitBtn.disabled = true;
                        
                        // Submit verification to server
                        const formData = new FormData();
                        formData.append('Code', code);
                        formData.append('__RequestVerificationToken', getCSRFToken());
                        
                        fetch('/Manage/EnableAuthenticator', {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => {
                            if (response.ok) {
                                // Check if response indicates success or error
                                return response.text().then(html => {
                                    if (html.includes('Recovery codes') || html.includes('ShowRecoveryCodes')) {
                                        // Success - 2FA was enabled
                                        return { success: true, html: html };
                                    } else if (html.includes('Verification code is invalid') || html.includes('text-danger')) {
                                        // Error in verification
                                        return { success: false, error: 'Invalid verification code' };
                                    } else {
                                        // Assume success if no clear error
                                        return { success: true };
                                    }
                                });
                            } else {
                                throw new Error('Server error');
                            }
                        })
                        .then(result => {
                            if (result.success) {
                                // Success - close modal and reload page
                                bootstrap.Modal.getInstance(document.getElementById('enable2FAModal')).hide();
                                showAlert('Two-factor authentication has been enabled successfully!', 'success');
                                setTimeout(() => window.location.reload(), 1500);
                            } else {
                                // Show error
                                showAlert(result.error || 'Invalid verification code. Please try again.', 'danger');
                            }
                        })
                        .catch(error => {
                            console.error('Error verifying code:', error);
                            showAlert('Error verifying code. Please try again.', 'danger');
                        })
                        .finally(() => {
                            // Restore button state
                            submitBtn.innerHTML = originalContent;
                            submitBtn.disabled = false;
                        });
                    });
                }
            });

            // Show recovery codes - fetch from server
            window.showRecoveryCodes = function() {
                // Try the JSON endpoint first
                fetch('/Manage/GetRecoveryCodes', {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.codes && data.codes.length > 0) {
                        displayRecoveryCodes(data.codes);
                    } else if (data.cannotDisplay) {
                        // Show information about recovery codes without displaying them
                        showRecoveryCodesInfo(data.recoveryCodesLeft, data.error);
                    } else if (data.needsGeneration) {
                        showConfirmation(
                            'No Recovery Codes Available',
                            'You don\'t have any recovery codes. Would you like to generate new ones?',
                            'Generate Codes',
                            function() {
                                generateRecoveryCodes();
                            }
                        );
                    } else {
                        // Fallback to HTML endpoint (for when codes are actually available)
                        return fetch('/Manage/ShowRecoveryCodes', {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => response.text())
                        .then(html => {
                            // Parse HTML to extract recovery codes
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            const codeElements = doc.querySelectorAll('code');
                            const codes = Array.from(codeElements).map(el => el.textContent.trim()).filter(code => code.length > 0);
                            
                            if (codes.length > 0) {
                                displayRecoveryCodes(codes);
                            } else {
                                showAlert('No recovery codes found. Please generate new codes.', 'warning');
                            }
                        });
                    }
                })
                .catch(error => {
                    console.error('Error loading recovery codes:', error);
                    showAlert('Error loading recovery codes. Please try again.', 'danger');
                });
            };

            // Show recovery codes information when actual codes cannot be displayed
            function showRecoveryCodesInfo(codesLeft, message) {
                const modal = document.getElementById('recoveryCodesModal');
                const modalTitle = modal.querySelector('.modal-title');
                const modalBody = modal.querySelector('.modal-body');
                
                modalTitle.innerHTML = '<i class="fas fa-info-circle me-2"></i>Recovery Codes Status';
                modalBody.innerHTML = `
                    <div class="alert alert-info">
                        <i class="fas fa-shield-alt me-2"></i>
                        <strong>Security Notice:</strong><br>
                        ${message}
                    </div>
                    <div class="text-center mt-3">
                        <p class="mb-3">
                            <i class="fas fa-key fa-2x text-muted"></i>
                        </p>
                        <p class="text-muted">
                            Recovery codes are stored securely and cannot be displayed after generation.<br>
                            If you need to see your recovery codes, you'll need to generate new ones.
                        </p>
                        <button type="button" class="btn btn-primary me-2" onclick="generateRecoveryCodes(); bootstrap.Modal.getInstance(document.getElementById('recoveryCodesModal')).hide();">
                            <i class="fas fa-sync me-1"></i>Generate New Codes
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Close
                        </button>
                    </div>
                `;
                
                const bootstrapModal = new bootstrap.Modal(modal);
                bootstrapModal.show();
            }

            // Generate new recovery codes
            window.generateRecoveryCodes = function() {
                showConfirmation(
                    'Generate New Recovery Codes',
                    'This will invalidate your existing recovery codes. Make sure you have access to your authenticator app.',
                    'Generate New Codes',
                    function() {
                        const formData = new FormData();
                        formData.append('__RequestVerificationToken', getCSRFToken());
                        
                        fetch('/Manage/GenerateRecoveryCodes', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => {
                            // Try to parse as JSON first
                            const contentType = response.headers.get('content-type');
                            if (contentType && contentType.includes('application/json')) {
                                return response.json();
                            } else {
                                return response.text().then(html => {
                                    // Parse HTML to extract new recovery codes
                                    const parser = new DOMParser();
                                    const doc = parser.parseFromString(html, 'text/html');
                                    const codeElements = doc.querySelectorAll('code');
                                    const codes = Array.from(codeElements).map(el => el.textContent.trim()).filter(code => code.length > 0);
                                    return { success: codes.length > 0, codes: codes };
                                });
                            }
                        })
                        .then(data => {
                            if (data.success && data.codes && data.codes.length > 0) {
                                displayRecoveryCodes(data.codes);
                                showAlert('New recovery codes generated successfully!', 'success');
                            } else {
                                showAlert('Error generating recovery codes. Please try again.', 'danger');
                            }
                        })
                        .catch(error => {
                            console.error('Error generating codes:', error);
                            showAlert('Error generating recovery codes. Please try again.', 'danger');
                        });
                    }
                );
            };

            // Disable 2FA
            window.disable2FA = function() {
                showConfirmation(
                    'Disable Two-Factor Authentication',
                    'This will make your account less secure. You will only be protected by your password.',
                    'Disable 2FA',
                    function() {
                        const formData = new FormData();
                        formData.append('__RequestVerificationToken', getCSRFToken());
                        
                        fetch('/Manage/Disable2fa', {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => {
                            if (response.ok) {
                                showAlert('Two-factor authentication has been disabled.', 'info');
                                setTimeout(() => window.location.reload(), 1500);
                            } else {
                                throw new Error('Server error');
                            }
                        })
                        .catch(error => {
                            console.error('Error disabling 2FA:', error);
                            showAlert('Error disabling 2FA. Please try again.', 'danger');
                        });
                    }
                );
            };

            // Setup/reconfigure authenticator
            window.setupAuthenticator = window.enable2FA;
            window.reconfigureAuthenticator = window.enable2FA;

            // Reset authenticator
            window.resetAuthenticator = function() {
                showConfirmation(
                    'Reset Authenticator Key',
                    'This will generate a new secret key. You will need to reconfigure your authenticator app.',
                    'Reset Key',
                    function() {
                        const formData = new FormData();
                        formData.append('__RequestVerificationToken', getCSRFToken());
                        
                        fetch('/Manage/ResetAuthenticator', {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => {
                            if (response.ok) {
                                showAlert('Authenticator key has been reset. You can now set up your authenticator app again.', 'info');
                                setTimeout(() => window.location.reload(), 1500);
                            } else {
                                throw new Error('Server error');
                            }
                        })
                        .catch(error => {
                            console.error('Error resetting authenticator:', error);
                            showAlert('Error resetting authenticator. Please try again.', 'danger');
                        });
                    }
                );
            };

            // Utility functions
            function showAlert(message, type = 'info') {
                // Create or update alert at top of page
                let alertContainer = document.getElementById('alertContainer');
                if (!alertContainer) {
                    alertContainer = document.createElement('div');
                    alertContainer.id = 'alertContainer';
                    alertContainer.style.position = 'fixed';
                    alertContainer.style.top = '20px';
                    alertContainer.style.right = '20px';
                    alertContainer.style.zIndex = '9999';
                    alertContainer.style.maxWidth = '400px';
                    document.body.appendChild(alertContainer);
                }
                
                const alert = document.createElement('div');
                alert.className = `alert alert-${type} alert-dismissible fade show`;
                alert.style.backgroundColor = getAlertBackgroundColor(type);
                alert.style.border = `1px solid ${getAlertBorderColor(type)}`;
                alert.style.color = getAlertTextColor(type);
                alert.innerHTML = `
                    <strong>${getAlertIcon(type)}</strong> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                
                alertContainer.appendChild(alert);
                
                // Auto-remove after 5 seconds
                setTimeout(() => {
                    if (alert.parentNode) {
                        alert.remove();
                    }
                }, 5000);
            }

            function getAlertBackgroundColor(type) {
                switch(type) {
                    case 'success': return '#d1edff';
                    case 'danger': return '#f8d7da';
                    case 'warning': return '#fff3cd';
                    case 'info': return '#d1ecf1';
                    default: return '#e2e3e5';
                }
            }

            function getAlertBorderColor(type) {
                switch(type) {
                    case 'success': return '#0f5132';
                    case 'danger': return '#842029';
                    case 'warning': return '#664d03';
                    case 'info': return '#055160';
                    default: return '#41464b';
                }
            }

            function getAlertTextColor(type) {
                switch(type) {
                    case 'success': return '#0f5132';
                    case 'danger': return '#842029';
                    case 'warning': return '#664d03';
                    case 'info': return '#055160';
                    default: return '#41464b';
                }
            }

            function getAlertIcon(type) {
                switch(type) {
                    case 'success': return '✅';
                    case 'danger': return '❌';
                    case 'warning': return '⚠️';
                    case 'info': return 'ℹ️';
                    default: return 'ℹ️';
                }
            }

            function showConfirmation(title, message, confirmText, onConfirm) {
                document.getElementById('confirmationModalLabel').textContent = title;
                document.getElementById('confirmationModalBody').innerHTML = `<p>${message}</p>`;
                document.getElementById('confirmActionBtn').textContent = confirmText;
                
                const modal = new bootstrap.Modal(document.getElementById('confirmationModal'));
                modal.show();
                
                // Remove any existing event listeners
                const newBtn = document.getElementById('confirmActionBtn').cloneNode(true);
                document.getElementById('confirmActionBtn').parentNode.replaceChild(newBtn, document.getElementById('confirmActionBtn'));
                
                // Set up new confirm button
                document.getElementById('confirmActionBtn').onclick = function() {
                    modal.hide();
                    onConfirm();
                };
            }

            function displayRecoveryCodes(codes) {
                const modal = document.getElementById('recoveryCodesModal');
                const modalTitle = modal.querySelector('.modal-title');
                const modalBody = modal.querySelector('.modal-body');
                
                // Restore original modal content structure
                modalTitle.innerHTML = '<i class="fas fa-key me-2"></i>Recovery Codes';
                modalBody.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Save these codes in a safe place!</strong><br>
                        <small>If you lose your device and don't have these codes, you'll lose access to your account.</small>
                    </div>
                    <div id="recoveryCodesList" class="recovery-codes-display">
                        ${codes.map(code => `<span class="recovery-code">${code}</span>`).join('')}
                    </div>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-outline-primary" onclick="downloadRecoveryCodes()">
                            <i class="fas fa-download me-1"></i>Download as Text
                        </button>
                        <button type="button" class="btn btn-outline-secondary ms-2" onclick="printRecoveryCodes()">
                            <i class="fas fa-print me-1"></i>Print
                        </button>
                    </div>
                `;
                
                const bootstrapModal = new bootstrap.Modal(modal);
                bootstrapModal.show();
            }

            // Download recovery codes
            window.downloadRecoveryCodes = function() {
                const codes = Array.from(document.querySelectorAll('.recovery-code'))
                    .map(el => el.textContent).join('\n');
                
                if (!codes) {
                    showAlert('No recovery codes to download', 'warning');
                    return;
                }
                
                const content = `Ribosoft Recovery Codes\n\nGenerated: ${new Date().toLocaleString()}\n\n${codes}\n\nIMPORTANT:\n- Keep these codes in a safe place\n- Each code can only be used once\n- If you lose your device and don't have these codes, you'll lose access to your account`;
                
                const blob = new Blob([content], { type: 'text/plain' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `ribosoft-recovery-codes-${new Date().toISOString().split('T')[0]}.txt`;
                a.click();
                window.URL.revokeObjectURL(url);
            };

            // Print recovery codes
            window.printRecoveryCodes = function() {
                const codes = Array.from(document.querySelectorAll('.recovery-code'))
                    .map(el => el.textContent).join('\n');
                
                if (!codes) {
                    showAlert('No recovery codes to print', 'warning');
                    return;
                }
                
                const printWindow = window.open('', '_blank');
                printWindow.document.write(`
                    <html>
                    <head>
                        <title>Ribosoft Recovery Codes</title>
                        <style>
                            body { font-family: Arial, sans-serif; padding: 20px; }
                            .header { border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px; }
                            .codes { font-family: monospace; font-size: 14px; background: #f5f5f5; padding: 15px; border-radius: 5px; }
                            .warning { background: #fff3cd; border: 1px solid #ffeaa7; padding: 10px; border-radius: 5px; margin-top: 20px; }
                        </style>
                    </head>
                    <body>
                        <div class="header">
                            <h2>Ribosoft Recovery Codes</h2>
                            <p>Generated: ${new Date().toLocaleString()}</p>
                        </div>
                        <div class="codes">${codes}</div>
                        <div class="warning">
                            <strong>IMPORTANT:</strong>
                            <ul>
                                <li>Keep these codes in a safe place</li>
                                <li>Each code can only be used once</li>
                                <li>If you lose your device and don't have these codes, you'll lose access to your account</li>
                            </ul>
                        </div>
                    </body>
                    </html>
                `);
                printWindow.document.close();
                printWindow.print();
            };
        })();
    </script>
}
