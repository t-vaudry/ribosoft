@model Ribosoft.Models.Ribozyme

@{
    ViewData["Title"] = "Delete Ribozyme";
}

<div class="container-fluid px-3 px-md-4">
    <div class="ribozymes-content">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1 text-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>Delete Ribozyme
                    </h1>
                    <p class="text-muted mb-0">Permanently remove this ribozyme and all associated structures</p>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Ribozymes" asp-action="Index" class="text-decoration-none">
                                <i class="fas fa-dna me-1"></i>Ribozymes
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-controller="Ribozymes" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
                                @Model.Name
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Delete</li>
                    </ol>
                </nav>
            </div>
        </div>

        <!-- Warning Alert -->
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1">Confirm Deletion</h5>
                    <p class="mb-0">
                        You are about to permanently delete this ribozyme and all its associated structures. 
                        <strong>This action cannot be undone.</strong>
                    </p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <!-- Ribozyme Information Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-1">
                    <i class="fas fa-info-circle me-2 text-primary"></i>Ribozyme Information
                </h5>
                <small class="text-muted">Details of the ribozyme to be deleted</small>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="row">
                                <div class="col-4">
                                    <span class="text-muted small fw-semibold">
                                        <i class="fas fa-hashtag me-1"></i>ID:
                                    </span>
                                </div>
                                <div class="col-8">
                                    <span class="badge bg-light text-dark border">#@Model.Id</span>
                                </div>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="row">
                                <div class="col-4">
                                    <span class="text-muted small fw-semibold">
                                        <i class="fas fa-tag me-1"></i>Name:
                                    </span>
                                </div>
                                <div class="col-8">
                                    <strong>@Html.DisplayFor(model => model.Name)</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="row">
                                <div class="col-4">
                                    <span class="text-muted small fw-semibold">
                                        <i class="fas fa-calendar-plus me-1"></i>Created:
                                    </span>
                                </div>
                                <div class="col-8">
                                    <small class="text-muted">@Html.DisplayFor(model => model.CreatedAt)</small>
                                </div>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="row">
                                <div class="col-4">
                                    <span class="text-muted small fw-semibold">
                                        <i class="fas fa-calendar-edit me-1"></i>Updated:
                                    </span>
                                </div>
                                <div class="col-8">
                                    <small class="text-muted">@Html.DisplayFor(model => model.UpdatedAt)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Associated Structures Card -->
        @if (Model.RibozymeStructures.Any())
        {
            <div class="card border-0 shadow-sm mb-4 border-warning">
                <div class="card-header bg-warning bg-opacity-10 border-bottom">
                    <h5 class="card-title mb-1 text-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>Associated Structures to be Deleted
                    </h5>
                    <small class="text-muted">@Model.RibozymeStructures.Count structure@(Model.RibozymeStructures.Count != 1 ? "s" : "") will also be permanently deleted</small>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Warning:</strong> The following @Model.RibozymeStructures.Count structure@(Model.RibozymeStructures.Count != 1 ? "s" : "") will also be permanently deleted:
                    </div>
                    
                    <div class="row">
                        @foreach (var structure in Model.RibozymeStructures.Select((value, index) => new { value, index }))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card border-warning">
                                    <div class="card-header bg-warning bg-opacity-10">
                                        <h6 class="mb-0 text-warning">
                                            <i class="fas fa-dna me-2"></i>
                                            Structure #@(structure.index + 1)
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <small class="text-muted">
                                            <i class="fas fa-cut me-1"></i>Cutsite: <strong>@structure.value.Cutsite</strong>
                                            <br>
                                            <i class="fas fa-cogs me-1"></i>Post Process: 
                                            @if (structure.value.PostProcess)
                                            {
                                                <span class="text-success"><strong>Enabled</strong></span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary"><strong>Disabled</strong></span>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Confirmation Form -->
        <div class="card border-0 shadow-sm mb-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-1">
                    <i class="fas fa-trash me-2"></i>Confirm Deletion
                </h5>
                <small class="text-white-50">Final confirmation required to proceed</small>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    <strong>Please confirm that you want to delete the ribozyme "@Model.Name" and all its associated data.</strong>
                </p>
                
                <div class="alert alert-light border" role="alert">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="confirmDeletion" required>
                        <label class="form-check-label fw-semibold" for="confirmDeletion">
                            I understand that this action is permanent and cannot be undone
                        </label>
                    </div>
                </div>
                
                @using (Html.BeginForm("Delete", "Ribozymes", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Id)
                    
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a class="btn btn-outline-secondary me-2" asp-controller="Ribozymes" asp-action="Details" asp-route-id="@Model.Id">
                                <i class="fas fa-arrow-left me-2"></i>Cancel
                            </a>
                            <a class="btn btn-outline-info" asp-controller="Ribozymes" asp-action="Index">
                                <i class="fas fa-list me-2"></i>Back to List
                            </a>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                <i class="fas fa-trash me-2"></i>Delete Permanently
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .ribozymes-content {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        padding-bottom: 1rem;
        border-bottom: 1px solid #e9ecef;
    }

    .card {
        border-radius: 0.5rem;
    }

    .card-header {
        border-radius: 0.5rem 0.5rem 0 0 !important;
    }

    .info-item {
        margin-bottom: 0.75rem;
    }

    .info-item:last-child {
        margin-bottom: 0;
    }

    /* Mobile responsiveness */
    @@media (max-width: 768px) {
        .page-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .page-header nav {
            margin-top: 0.5rem;
        }

        .card-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .card-header .btn,
        .card-header .btn-group {
            margin-top: 0.5rem;
        }
    }
</style>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function() {
            // Enable/disable delete button based on confirmation checkbox
            $('#confirmDeletion').change(function() {
                $('#deleteButton').prop('disabled', !this.checked);
            });
            
            // Add additional confirmation on form submit
            $('form').submit(function(e) {
                if (!$('#confirmDeletion').is(':checked')) {
                    e.preventDefault();
                    alert('Please confirm that you understand this action is permanent.');
                    return false;
                }
                
                var confirmed = confirm('Are you absolutely sure you want to delete the ribozyme "@Model.Name"? This action cannot be undone.');
                if (!confirmed) {
                    e.preventDefault();
                    return false;
                }
                
                // Show loading state
                $('#deleteButton').html('<i class="fas fa-spinner fa-spin me-2"></i>Deleting...').prop('disabled', true);
            });
        });
    </script>
}
