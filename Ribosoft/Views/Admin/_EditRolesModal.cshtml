@model Ribosoft.Models.AdminViewModels.EditUserRolesViewModel

<form id="editRolesForm" asp-action="UpdateUserRoles" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    
    <div class="mb-3">
        <label class="form-label">
            <strong>User:</strong> @Model.DisplayName (@Model.UserName)
        </label>
    </div>
    
    <div class="mb-3">
        <label class="form-label">Roles:</label>
        @for (int i = 0; i < Model.AvailableRoles.Count; i++)
        {
            var role = Model.AvailableRoles[i];
            var isChecked = Model.UserRoles.Contains(role);
            
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" 
                       id="role_@role" @(isChecked ? "checked" : "") />
                <label class="form-check-label" for="role_@role">
                    <span class="badge @(role == "Administrator" ? "bg-warning text-dark" : role == "Guest" ? "bg-secondary" : "bg-primary") me-2">@role</span>
                    @switch (role)
                    {
                        case "Administrator":
                            <span>Full system access and user management</span>
                            break;
                        case "Guest":
                            <span>Limited access with basic functionality</span>
                            break;
                        default:
                            <span>Standard user access</span>
                            break;
                    }
                </label>
            </div>
        }
    </div>
    
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Update Roles
        </button>
    </div>
</form>

<script>
    $('#editRolesForm').on('submit', function(e) {
        e.preventDefault();
        
        var formData = new FormData(this);
        
        $.ajax({
            url: $(this).attr('action'),
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    $('#editRolesModal').modal('hide');
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function() {
                alert('Error updating user roles.');
            }
        });
    });
</script>
