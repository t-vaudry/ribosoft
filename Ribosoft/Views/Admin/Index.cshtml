@model Ribosoft.Models.AdminViewModels.UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

<div class="container-fluid px-2 px-md-3">
    <div class="admin-content">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="fas fa-users me-2 text-primary"></i>@ViewData["Title"]
                    </h1>
                    <p class="text-muted mb-0">Manage user accounts, roles, and permissions</p>
                </div>
                <div class="admin-badge-container">
                    <span class="badge bg-warning text-dark">
                        <i class="fas fa-crown me-1"></i>Admin Only
                    </span>
                </div>
            </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-6 col-lg-7">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" name="searchTerm" value="@Model.SearchTerm" 
                                   placeholder="Search by username, email, or name..." />
                        </div>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <select class="form-select" name="roleFilter">
                            <option value="">All Roles</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role" selected="@(Model.RoleFilter == role)">@role</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-3">
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary flex-fill" type="submit">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter))
                            {
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                    <i class="fas fa-times"></i>
                                </a>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Users Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="fas fa-users me-2"></i>
                            User Management
                        </h5>
                        <small class="text-muted">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter))
                            {
                                <span>Showing @Model.Users.Count of @Model.TotalUsers users</span>
                            }
                            else
                            {
                                <span>@Model.TotalUsers total users</span>
                            }
                        </small>
                    </div>
                    <div>
                        <span class="badge bg-info">
                            <i class="fas fa-users me-1"></i>
                            @Model.TotalUsers Total
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.Users.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 fw-semibold" style="width: 20%;">
                                        <i class="fas fa-user me-1 text-muted"></i>
                                        User
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 25%;">
                                        <i class="fas fa-envelope me-1 text-muted"></i>
                                        Email
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 10%;">
                                        <i class="fas fa-user-tag me-1 text-muted"></i>
                                        Role
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 15%;">
                                        <i class="fas fa-shield-alt me-1 text-muted"></i>
                                        Status
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 8%;">
                                        <i class="fas fa-tasks me-1 text-muted"></i>
                                        Jobs
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 12%;">
                                        <i class="fas fa-clock me-1 text-muted"></i>
                                        Last Login
                                    </th>
                                    <th class="border-0 fw-semibold text-center" style="width: 10%;">
                                        <i class="fas fa-cogs me-1 text-muted"></i>
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr data-user-id="@user.Id">
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                <div class="user-avatar me-3">
                                                    @if (user.Roles.Contains("Administrator"))
                                                    {
                                                        <div class="avatar-circle bg-warning">
                                                            <i class="fas fa-crown text-white"></i>
                                                        </div>
                                                    }
                                                    else if (user.Roles.Contains("Guest"))
                                                    {
                                                        <div class="avatar-circle bg-secondary">
                                                            <i class="fas fa-user text-white"></i>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-circle bg-primary">
                                                            <i class="fas fa-user text-white"></i>
                                                        </div>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark">@user.DisplayName</div>
                                                    <small class="text-muted">@user.UserName</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                <span class="me-2">@user.Email</span>
                                                @if (user.EmailConfirmed)
                                                {
                                                    <i class="fas fa-check-circle text-success" title="Email Confirmed"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-exclamation-circle text-warning" title="Email Not Confirmed"></i>
                                                }
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge @(user.PrimaryRole == "Administrator" ? "bg-warning text-dark" : user.PrimaryRole == "Guest" ? "bg-secondary" : "bg-primary")">
                                                @user.PrimaryRole
                                            </span>
                                        </td>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center gap-1">
                                                @if (user.IsLockedOut)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-lock me-1"></i>Locked
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check me-1"></i>Active
                                                    </span>
                                                }
                                                @if (user.TwoFactorEnabled)
                                                {
                                                    <span class="badge bg-info" title="2FA Enabled">
                                                        <i class="fas fa-shield-alt"></i>
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge bg-light text-dark border">@user.JobCount</span>
                                        </td>
                                        <td class="align-middle">
                                            @if (user.LastLoginDate.HasValue)
                                            {
                                                <small class="text-muted">@user.LastLoginDate.Value.ToString("MMM dd, yyyy")</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">Never</small>
                                            }
                                        </td>
                                        <td class="align-middle text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-primary btn-view-user" 
                                                        data-user-id="@user.Id" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-edit-roles" 
                                                        data-user-id="@user.Id" title="Edit Roles">
                                                    <i class="fas fa-user-tag"></i>
                                                </button>
                                                @if (!user.Roles.Contains("Administrator"))
                                                {
                                                    <button type="button" class="btn btn-outline-warning btn-toggle-lockout" 
                                                            data-user-id="@user.Id" title="@(user.IsLockedOut ? "Unlock User" : "Lock User")">
                                                        <i class="fas @(user.IsLockedOut ? "fa-unlock" : "fa-lock")"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger btn-reset-password" 
                                                            data-user-id="@user.Id" title="Reset Password">
                                                        <i class="fas fa-key"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="empty-state">
                            <i class="fas fa-users text-muted mb-3" style="font-size: 3rem;"></i>
                            <h5 class="text-muted">No users found</h5>
                            <p class="text-muted">Try adjusting your search criteria or filters.</p>
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter))
                            {
                                <a href="@Url.Action("Index")" class="btn btn-primary">
                                    <i class="fas fa-times me-2"></i>Clear Filters
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top">
                    <nav aria-label="User pagination">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = Model.CurrentPage - 1 })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = i })">@i</a>
                                </li>
                            }
                            
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = Model.CurrentPage + 1 })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- User Details Modal -->
<div class="modal fade" id="userDetailsModal" tabindex="-1" aria-labelledby="userDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userDetailsModalLabel">
                    <i class="fas fa-user me-2"></i>User Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="userDetailsContent">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Roles Modal -->
<div class="modal fade" id="editRolesModal" tabindex="-1" aria-labelledby="editRolesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRolesModalLabel">
                    <i class="fas fa-user-tag me-2"></i>Edit User Roles
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editRolesContent">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-content {
        /* Match the styling from other views */
    }

    .page-header {
        /* Consistent page header styling */
    }

    .admin-badge-container {
        display: flex;
        align-items: center;
    }

    .user-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .empty-state {
        /* Match empty state styling from other views */
    }

    .table th {
        border-top: none !important;
        font-weight: 600;
        color: #495057;
        background-color: #f8f9fa;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.025);
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    /* Table width optimization */
    .table {
        table-layout: fixed;
        width: 100%;
    }

    .table td {
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Better spacing for user info */
    .table td:first-child {
        min-width: 180px;
    }

    .table td:nth-child(2) {
        min-width: 200px;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.875rem;
        }
        
        .btn-group-sm .btn {
            padding: 0.2rem 0.4rem;
        }
        
        .avatar-circle {
            width: 28px;
            height: 28px;
            font-size: 10px;
        }

        .table {
            table-layout: auto;
        }
    }

    @@media (min-width: 1200px) {
        .container-fluid {
            max-width: 1400px;
            margin: 0 auto;
        }
    }

    /* Card styling consistency */
    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .card-header {
        background-color: #fff;
        border-bottom: 1px solid #dee2e6;
    }

    .card-footer {
        background-color: #fff;
        border-top: 1px solid #dee2e6;
    }

    /* Input group styling */
    .input-group-text.bg-light {
        background-color: #f8f9fa !important;
    }

    .form-control.border-start-0 {
        border-left: 0;
    }

    .input-group-text.border-end-0 {
        border-right: 0;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // View user details
            $('.btn-view-user').click(function() {
                var userId = $(this).data('user-id');
                $('#userDetailsContent').html('<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                $('#userDetailsModal').modal('show');
                
                $.get('@Url.Action("GetUserDetails")', { id: userId })
                    .done(function(data) {
                        var html = buildUserDetailsHtml(data);
                        $('#userDetailsContent').html(html);
                    })
                    .fail(function() {
                        $('#userDetailsContent').html('<div class="alert alert-danger">Error loading user details.</div>');
                    });
            });

            // Edit user roles
            $('.btn-edit-roles').click(function() {
                var userId = $(this).data('user-id');
                $('#editRolesContent').html('<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                $('#editRolesModal').modal('show');
                
                $.get('@Url.Action("GetUserDetails")', { id: userId })
                    .done(function(data) {
                        var html = buildEditRolesHtml(data);
                        $('#editRolesContent').html(html);
                    })
                    .fail(function() {
                        $('#editRolesContent').html('<div class="alert alert-danger">Error loading user roles.</div>');
                    });
            });

            // Toggle user lockout
            $('.btn-toggle-lockout').click(function() {
                var userId = $(this).data('user-id');
                var button = $(this);
                
                if (confirm('Are you sure you want to change this user\'s lockout status?')) {
                    $.post('@Url.Action("ToggleUserLockout")', { 
                        id: userId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    })
                    .done(function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('Error updating user lockout status.');
                    });
                }
            });

            // Reset user password
            $('.btn-reset-password').click(function() {
                var userId = $(this).data('user-id');
                
                if (confirm('Are you sure you want to reset this user\'s password? A new temporary password will be generated.')) {
                    $.post('@Url.Action("ResetUserPassword")', { 
                        id: userId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    })
                    .done(function(response) {
                        if (response.success) {
                            alert('Password reset successfully. New password: ' + response.newPassword + '\n\nPlease provide this to the user securely.');
                        } else {
                            alert('Error: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('Error resetting user password.');
                    });
                }
            });
        });

        function buildUserDetailsHtml(user) {
            var html = '<div class="row">';
            html += '<div class="col-md-6">';
            html += '<h6><i class="fas fa-user me-2"></i>Basic Information</h6>';
            html += '<table class="table table-sm">';
            html += '<tr><td><strong>Username:</strong></td><td>' + user.userName + '</td></tr>';
            html += '<tr><td><strong>Email:</strong></td><td>' + user.email + (user.emailConfirmed ? ' <i class="fas fa-check-circle text-success"></i>' : ' <i class="fas fa-exclamation-circle text-warning"></i>') + '</td></tr>';
            html += '<tr><td><strong>Name:</strong></td><td>' + (user.firstName || '') + ' ' + (user.lastName || '') + '</td></tr>';
            html += '<tr><td><strong>Phone:</strong></td><td>' + (user.phoneNumber || 'Not provided') + '</td></tr>';
            html += '<tr><td><strong>Registered:</strong></td><td>' + new Date(user.registrationDate).toLocaleDateString() + '</td></tr>';
            html += '<tr><td><strong>Last Login:</strong></td><td>' + (user.lastLoginDate ? new Date(user.lastLoginDate).toLocaleDateString() : 'Never') + '</td></tr>';
            html += '</table>';
            html += '</div>';
            html += '<div class="col-md-6">';
            html += '<h6><i class="fas fa-shield-alt me-2"></i>Security & Status</h6>';
            html += '<table class="table table-sm">';
            html += '<tr><td><strong>Roles:</strong></td><td>' + user.roles.join(', ') + '</td></tr>';
            html += '<tr><td><strong>2FA Enabled:</strong></td><td>' + (user.twoFactorEnabled ? 'Yes' : 'No') + '</td></tr>';
            html += '<tr><td><strong>Failed Attempts:</strong></td><td>' + user.accessFailedCount + '</td></tr>';
            html += '<tr><td><strong>Locked Out:</strong></td><td>' + (user.isLockedOut ? 'Yes' : 'No') + '</td></tr>';
            html += '<tr><td><strong>Jobs Created:</strong></td><td>' + user.jobCount + '</td></tr>';
            html += '</table>';
            html += '</div>';
            html += '</div>';
            return html;
        }

        function buildEditRolesHtml(user) {
            var availableRoles = @Html.Raw(Json.Serialize(Model.AvailableRoles));
            var html = '<form id="editRolesForm">';
            html += '<input type="hidden" name="userId" value="' + user.id + '" />';
            html += '<div class="mb-3">';
            html += '<label class="form-label"><strong>User:</strong> ' + user.displayName + ' (' + user.userName + ')</label>';
            html += '</div>';
            html += '<div class="mb-3">';
            html += '<label class="form-label">Roles:</label>';
            
            availableRoles.forEach(function(role) {
                var checked = user.roles.includes(role) ? 'checked' : '';
                html += '<div class="form-check">';
                html += '<input class="form-check-input" type="checkbox" name="roles" value="' + role + '" id="role_' + role + '" ' + checked + '>';
                html += '<label class="form-check-label" for="role_' + role + '">' + role + '</label>';
                html += '</div>';
            });
            
            html += '</div>';
            html += '<div class="d-flex justify-content-end">';
            html += '<button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>';
            html += '<button type="submit" class="btn btn-primary">Update Roles</button>';
            html += '</div>';
            html += '</form>';
            
            setTimeout(function() {
                $('#editRolesForm').submit(function(e) {
                    e.preventDefault();
                    var formData = {
                        userId: $('input[name="userId"]').val(),
                        roles: []
                    };
                    
                    $('input[name="roles"]:checked').each(function() {
                        formData.roles.push($(this).val());
                    });
                    
                    $.ajax({
                        url: '@Url.Action("UpdateUserRoles")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(formData),
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    })
                    .done(function(response) {
                        if (response.success) {
                            $('#editRolesModal').modal('hide');
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('Error updating user roles.');
                    });
                });
            }, 100);
            
            return html;
        }
    </script>
}

@Html.AntiForgeryToken()
