@model Ribosoft.Models.AdminViewModels.UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

<div class="container-fluid px-2 px-md-3">
    <div class="admin-content">
        <!-- Page Header -->
        <div class="page-header mb-4 px-3 pt-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="fas fa-users me-2 text-primary"></i>@ViewData["Title"]
                    </h1>
                    <p class="text-muted mb-0">Manage user accounts, roles, and permissions</p>
                </div>
                <div class="admin-badge-container">
                    <span class="badge bg-warning text-dark">
                        <i class="fas fa-crown me-1"></i>Admin Only
                    </span>
                </div>
            </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-6 col-lg-7">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" name="searchTerm" value="@Model.SearchTerm" 
                                   placeholder="Search by username, email, or name..." />
                        </div>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <select class="form-select" name="roleFilter">
                            <option value="">All Roles</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role" selected="@(Model.RoleFilter == role)">@role</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-3">
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary flex-fill" type="submit">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter))
                            {
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                    <i class="fas fa-times"></i>
                                </a>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Users Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="fas fa-users me-2"></i>
                            User Management
                        </h5>
                        <small class="text-muted">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter))
                            {
                                <span>Showing @Model.Users.Count of @Model.TotalUsers users</span>
                            }
                            else
                            {
                                <span>@Model.TotalUsers total users</span>
                            }
                        </small>
                    </div>
                    <div>
                        <span class="badge bg-info">
                            <i class="fas fa-users me-1"></i>
                            @Model.TotalUsers Total
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.Users.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 fw-semibold" style="width: 25%;">
                                        <i class="fas fa-user me-1 text-muted"></i>
                                        User
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 30%;">
                                        <i class="fas fa-envelope me-1 text-muted"></i>
                                        Email
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 12%;">
                                        <i class="fas fa-user-tag me-1 text-muted"></i>
                                        Role
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 18%;">
                                        <i class="fas fa-shield-alt me-1 text-muted"></i>
                                        Status
                                    </th>
                                    <th class="border-0 fw-semibold" style="width: 8%;">
                                        <i class="fas fa-tasks me-1 text-muted"></i>
                                        Jobs
                                    </th>
                                    <th class="border-0 fw-semibold text-center" style="width: 7%;">
                                        <i class="fas fa-cogs me-1 text-muted"></i>
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr data-user-id="@user.Id">
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                <div class="user-avatar me-3">
                                                    @if (user.Roles.Contains("Administrator"))
                                                    {
                                                        <div class="avatar-circle bg-warning">
                                                            <i class="fas fa-crown text-white"></i>
                                                        </div>
                                                    }
                                                    else if (user.Roles.Contains("Guest"))
                                                    {
                                                        <div class="avatar-circle bg-secondary">
                                                            <i class="fas fa-user text-white"></i>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-circle bg-primary">
                                                            <i class="fas fa-user text-white"></i>
                                                        </div>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark">@user.UserName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                <span class="me-2">@user.Email</span>
                                                @if (user.EmailConfirmed)
                                                {
                                                    <i class="fas fa-check-circle text-success" title="Email Confirmed"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-exclamation-circle text-warning" title="Email Not Confirmed"></i>
                                                }
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge @(user.PrimaryRole == "Administrator" ? "bg-warning text-dark" : user.PrimaryRole == "Guest" ? "bg-secondary" : "bg-primary")">
                                                @user.PrimaryRole
                                            </span>
                                        </td>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center gap-1">
                                                @if (user.IsLockedOut)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-lock me-1"></i>Locked
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check me-1"></i>Active
                                                    </span>
                                                }
                                                @if (user.TwoFactorEnabled)
                                                {
                                                    <span class="badge bg-info" title="2FA Enabled">
                                                        <i class="fas fa-shield-alt"></i>
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge bg-light text-dark border">@user.JobCount</span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-primary btn-view-user" 
                                                        data-user-id="@user.Id" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-edit-roles" 
                                                        data-user-id="@user.Id" title="Edit Roles">
                                                    <i class="fas fa-user-tag"></i>
                                                </button>
                                                @if (!user.Roles.Contains("Administrator"))
                                                {
                                                    <button type="button" class="btn btn-outline-warning btn-toggle-lockout" 
                                                            data-user-id="@user.Id" title="@(user.IsLockedOut ? "Unlock User" : "Lock User")">
                                                        <i class="fas @(user.IsLockedOut ? "fa-unlock" : "fa-lock")"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger btn-reset-password" 
                                                            data-user-id="@user.Id" title="Reset Password">
                                                        <i class="fas fa-key"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="empty-state">
                            <i class="fas fa-users text-muted mb-3" style="font-size: 3rem;"></i>
                            <h5 class="text-muted">No users found</h5>
                            <p class="text-muted">Try adjusting your search criteria or filters.</p>
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter))
                            {
                                <a href="@Url.Action("Index")" class="btn btn-primary">
                                    <i class="fas fa-times me-2"></i>Clear Filters
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top">
                    <nav aria-label="User pagination">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = Model.CurrentPage - 1 })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = i })">@i</a>
                                </li>
                            }
                            
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = Model.CurrentPage + 1 })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- User Details Modal -->
<div class="modal fade" id="userDetailsModal" tabindex="-1" aria-labelledby="userDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userDetailsModalLabel">
                    <i class="fas fa-user me-2"></i>User Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="userDetailsContent">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Roles Modal -->
<div class="modal fade" id="editRolesModal" tabindex="-1" aria-labelledby="editRolesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRolesModalLabel">
                    <i class="fas fa-user-tag me-2"></i>Edit User Roles
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editRolesContent">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lock/Unlock User Modal -->
<div class="modal fade" id="lockUserModal" tabindex="-1" aria-labelledby="lockUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="lockUserModalLabel">
                    <i class="fas fa-lock me-2"></i>Confirm User Lockout
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0 me-3">
                        <i class="fas fa-exclamation-triangle text-warning fa-2x"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-2" id="lockUserAction">Lock User Account</h6>
                        <p class="mb-3" id="lockUserMessage">
                            Are you sure you want to lock this user account? The user will not be able to log in until the account is unlocked.
                        </p>
                        <div class="bg-light p-3 rounded">
                            <strong>User:</strong> <span id="lockUserName"></span><br>
                            <strong>Email:</strong> <span id="lockUserEmail"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmLockUser">
                    <i class="fas fa-lock me-1"></i>Lock User
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resetPasswordModalLabel">
                    <i class="fas fa-key me-2"></i>Reset User Password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0 me-3">
                        <i class="fas fa-exclamation-triangle text-warning fa-2x"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-2">Reset Password Confirmation</h6>
                        <p class="mb-3">
                            Are you sure you want to reset this user's password? A new temporary password will be generated and displayed. 
                            <strong>Make sure to provide this password to the user securely.</strong>
                        </p>
                        <div class="bg-light p-3 rounded">
                            <strong>User:</strong> <span id="resetPasswordUserName"></span><br>
                            <strong>Email:</strong> <span id="resetPasswordUserEmail"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmResetPassword">
                    <i class="fas fa-key me-1"></i>Reset Password
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Password Reset Result Modal -->
<div class="modal fade" id="passwordResetResultModal" tabindex="-1" aria-labelledby="passwordResetResultModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="passwordResetResultModalLabel">
                    <i class="fas fa-check-circle text-success me-2"></i>Password Reset Successful
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>
                    Password has been reset successfully!
                </div>
                <div class="mb-3">
                    <label class="form-label"><strong>New Temporary Password:</strong></label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="newPasswordDisplay" readonly>
                        <button class="btn btn-outline-secondary" type="button" id="copyPasswordBtn">
                            <i class="fas fa-copy me-1"></i>Copy
                        </button>
                    </div>
                </div>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Important:</strong> Please provide this password to the user through a secure channel. 
                    The user should change this password immediately after logging in.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-content {
        /* Match the styling from other views */
    }

    .page-header {
        /* Consistent page header styling */
    }

    .admin-badge-container {
        display: flex;
        align-items: center;
    }

    .user-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .empty-state {
        /* Match empty state styling from other views */
    }

    /* Table styling improvements */
    .table th,
    .table td {
        border-top: none !important;
        padding: 0.75rem;
        vertical-align: middle;
    }

    .table th {
        font-weight: 600;
        color: #495057;
        background-color: #f8f9fa;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.025);
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    /* Table width optimization */
    .table {
        width: 100%;
    }

    .table td {
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Better spacing for user info */
    .table td:first-child {
        min-width: 200px;
    }

    .table td:nth-child(2) {
        min-width: 220px;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.875rem;
        }
        
        .btn-group-sm .btn {
            padding: 0.2rem 0.4rem;
        }
        
        .avatar-circle {
            width: 28px;
            height: 28px;
            font-size: 10px;
        }

        .table {
            table-layout: fixed;
        }

        .table td:first-child {
            min-width: 150px;
        }

        .table td:nth-child(2) {
            min-width: 180px;
        }
    }

    @@media (min-width: 1200px) {
        .container-fluid {
            max-width: 1400px;
            margin: 0 auto;
        }
    }

    /* Card styling consistency */
    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .card-header {
        background-color: #fff;
        border-bottom: 1px solid #dee2e6;
    }

    .card-footer {
        background-color: #fff;
        border-top: 1px solid #dee2e6;
    }

    /* Input group styling */
    .input-group-text.bg-light {
        background-color: #f8f9fa !important;
    }

    .form-control.border-start-0 {
        border-left: 0;
    }

    .input-group-text.border-end-0 {
        border-right: 0;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // View user details
            $('.btn-view-user').click(function() {
                var userId = $(this).data('user-id');
                $('#userDetailsContent').html('<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                $('#userDetailsModal').modal('show');
                
                $.get('@Url.Action("GetUserDetailsModal")', { id: userId })
                    .done(function(data) {
                        $('#userDetailsContent').html(data);
                    })
                    .fail(function() {
                        $('#userDetailsContent').html('<div class="alert alert-danger">Error loading user details.</div>');
                    });
            });

            // Edit user roles
            $('.btn-edit-roles').click(function() {
                var userId = $(this).data('user-id');
                $('#editRolesContent').html('<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                $('#editRolesModal').modal('show');
                
                $.get('@Url.Action("GetEditRolesModal")', { id: userId })
                    .done(function(data) {
                        $('#editRolesContent').html(data);
                    })
                    .fail(function() {
                        $('#editRolesContent').html('<div class="alert alert-danger">Error loading user roles.</div>');
                    });
            });

            // Toggle user lockout - show modal
            $('.btn-toggle-lockout').click(function() {
                var userId = $(this).data('user-id');
                var button = $(this);
                var row = button.closest('tr');
                var userName = row.find('td:first .fw-semibold').text().trim();
                var userEmail = row.find('td:nth-child(2)').text().trim();
                var isLocked = button.find('i').hasClass('fa-unlock');
                
                // Update modal content based on current lock status
                if (isLocked) {
                    $('#lockUserModalLabel').html('<i class="fas fa-unlock me-2"></i>Confirm User Unlock');
                    $('#lockUserAction').text('Unlock User Account');
                    $('#lockUserMessage').text('Are you sure you want to unlock this user account? The user will be able to log in again.');
                    $('#confirmLockUser').removeClass('btn-warning').addClass('btn-success')
                        .html('<i class="fas fa-unlock me-1"></i>Unlock User');
                } else {
                    $('#lockUserModalLabel').html('<i class="fas fa-lock me-2"></i>Confirm User Lockout');
                    $('#lockUserAction').text('Lock User Account');
                    $('#lockUserMessage').text('Are you sure you want to lock this user account? The user will not be able to log in until the account is unlocked.');
                    $('#confirmLockUser').removeClass('btn-success').addClass('btn-warning')
                        .html('<i class="fas fa-lock me-1"></i>Lock User');
                }
                
                $('#lockUserName').text(userName);
                $('#lockUserEmail').text(userEmail);
                $('#confirmLockUser').data('user-id', userId);
                $('#lockUserModal').modal('show');
            });

            // Confirm lock/unlock user
            $('#confirmLockUser').click(function() {
                var userId = $(this).data('user-id');
                
                $.post('@Url.Action("ToggleUserLockout")', { 
                    id: userId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(response) {
                    $('#lockUserModal').modal('hide');
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                })
                .fail(function() {
                    $('#lockUserModal').modal('hide');
                    alert('Error updating user lockout status.');
                });
            });

            // Reset user password - show modal
            $('.btn-reset-password').click(function() {
                var userId = $(this).data('user-id');
                var button = $(this);
                var row = button.closest('tr');
                var userName = row.find('td:first .fw-semibold').text().trim();
                var userEmail = row.find('td:nth-child(2)').text().trim();
                
                $('#resetPasswordUserName').text(userName);
                $('#resetPasswordUserEmail').text(userEmail);
                $('#confirmResetPassword').data('user-id', userId);
                $('#resetPasswordModal').modal('show');
            });

            // Confirm reset password
            $('#confirmResetPassword').click(function() {
                var userId = $(this).data('user-id');
                
                $.post('@Url.Action("ResetUserPassword")', { 
                    id: userId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(response) {
                    $('#resetPasswordModal').modal('hide');
                    if (response.success) {
                        $('#newPasswordDisplay').val(response.newPassword);
                        $('#passwordResetResultModal').modal('show');
                    } else {
                        alert('Error: ' + response.message);
                    }
                })
                .fail(function() {
                    $('#resetPasswordModal').modal('hide');
                    alert('Error resetting user password.');
                });
            });

            // Copy password to clipboard
            $('#copyPasswordBtn').click(function() {
                var passwordField = document.getElementById('newPasswordDisplay');
                passwordField.select();
                passwordField.setSelectionRange(0, 99999); // For mobile devices
                
                try {
                    document.execCommand('copy');
                    $(this).html('<i class="fas fa-check me-1"></i>Copied!');
                    setTimeout(() => {
                        $(this).html('<i class="fas fa-copy me-1"></i>Copy');
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy password: ', err);
                }
            });
        });
    </script>
}

@Html.AntiForgeryToken()
