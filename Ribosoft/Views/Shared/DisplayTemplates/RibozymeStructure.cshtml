@model Ribosoft.Models.RibozymeStructure

<tr class="align-middle">
    <td class="text-center">
        <span class="badge bg-danger">
            <i class="fas fa-cut me-1"></i>@Html.DisplayFor(model => model.Cutsite)
        </span>
    </td>
    <td>
        <div class="sequence-display">
            <div class="mb-2">
                <small class="text-muted fw-semibold">
                    <i class="fas fa-dna me-1"></i>Sequence:
                </small>
                <br>
                <code class="text-primary user-select-all">@Html.DisplayFor(model => model.Sequence)</code>
            </div>
            <div>
                <small class="text-muted fw-semibold">
                    <i class="fas fa-project-diagram me-1"></i>Structure:
                </small>
                <br>
                <code class="text-secondary user-select-all">@Html.DisplayFor(model => model.Structure)</code>
            </div>
        </div>
    </td>
    <td>
        <div class="sequence-display">
            <div class="mb-2">
                <small class="text-muted fw-semibold">
                    <i class="fas fa-flask me-1"></i>Template:
                </small>
                <br>
                <code class="text-info user-select-all">@Html.DisplayFor(model => model.SubstrateTemplate)</code>
            </div>
            <div>
                <small class="text-muted fw-semibold">
                    <i class="fas fa-sitemap me-1"></i>Structure:
                </small>
                <br>
                <code class="text-secondary user-select-all">@Html.DisplayFor(model => model.SubstrateStructure)</code>
            </div>
        </div>
    </td>
    <td class="text-center">
        @if (Model.PostProcess)
        {
            <span class="badge bg-success">
                <i class="fas fa-check-circle me-1"></i>Enabled
            </span>
        }
        else
        {
            <span class="badge bg-secondary">
                <i class="fas fa-times-circle me-1"></i>Disabled
            </span>
        }
    </td>
    <td class="text-center">
        <div class="btn-group" role="group">
            <button type="button" 
                    class="btn btn-outline-info btn-sm" 
                    data-bs-toggle="modal" 
                    data-bs-target="#visualizationModal" 
                    id="rna_ss_@Model.Id" 
                    sequence="@Model.Sequence" 
                    structure="@Model.Structure" 
                    subsequence="@Model.SubstrateTemplate" 
                    substructure="@Model.SubstrateStructure" 
                    cutsite="@Model.Cutsite"
                    title="Visualize Structure">
                <i class="fas fa-eye me-1"></i>View
            </button>
            @if (User.IsInRole("Administrator"))
            {
                <a asp-controller="RibozymeStructures" asp-action="Edit" asp-route-id="@Model.Id" 
                   class="btn btn-outline-secondary btn-sm" title="Edit Structure">
                    <i class="fas fa-edit me-1"></i>Edit
                </a>
                <button type="button" 
                        class="btn btn-outline-danger btn-sm delete-structure-btn" 
                        data-structure-id="@Model.Id"
                        data-ribozyme-id="@Model.RibozymeId"
                        data-bs-toggle="modal" 
                        data-bs-target="#deleteStructureModal"
                        title="Delete Structure">
                    <i class="fas fa-trash me-1"></i>Delete
                </button>
            }
        </div>
    </td>
</tr>

<style>
    .sequence-display {
        background-color: #f8f9fa;
        padding: 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid #e9ecef;
    }

    .sequence-display code {
        font-size: 0.875rem;
        word-break: break-all;
        white-space: pre-wrap;
    }

    .sequence-display:hover {
        background-color: #e9ecef;
    }
</style>
